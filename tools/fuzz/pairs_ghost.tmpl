-- ghost-range fuzz: grow, traverse, shrink partway while paused, sparse writes in (L,H],
-- grow back over them (hash->array migration into the ghost range), resume next().
local seed = @SEED@
local ROUNDS = @ROUNDS@
local UNDEF = @UNDEF@      -- true: also do insertions while paused (Lua: undefined; only termination is checked)
local function rand(n) seed = (seed * 48271) % 2147483647; return seed % n end
local fail = false
local function report(msg, r) print("DEFECT", msg, "seed=@SEED@", "round=" .. r); fail = true end
local MAXK = 400
local function universe(t)  -- live keys among the possible ones
  local s, n = {}, 0
  for i = -2, MAXK do if rawget(t, i) ~= nil then s[i] = true; n = n + 1 end end
  for i = 1, 6 do local k = "s" .. i; if rawget(t, k) ~= nil then s[k] = true; n = n + 1 end end
  return s, n
end
local function full_check(t, r, tag)
  local live, n = universe(t)
  local seen, c = {}, 0
  for k in pairs(t) do
    c = c + 1
    if c > n * 4 + 10 then report(tag .. " RUNAWAY", r) return end
    if seen[k] then report(tag .. " DUP " .. tostring(k), r) end
    seen[k] = true
    if rawget(t, k) == nil then report(tag .. " DEAD " .. tostring(k), r) end
  end
  for k in pairs(live) do if not seen[k] then report(tag .. " MISSED " .. tostring(k), r) end end
end
local t = {}
for r = 1, ROUNDS do
  if rand(5) == 0 or #t > 150 then t = {} end
  -- between traversals (all defined): grow, shrink, sparse writes above the border, grow back over them
  local g = rand(60)
  for i = 1, g do t[#t + 1] = r end
  for i = 1, rand(6) do t["s" .. (rand(6) + 1)] = r end
  if rand(2) == 0 then local s = rand(#t + 1); for i = 1, s do t[#t] = nil end end
  if rand(2) == 0 then for i = 1, rand(5) do t[#t + 2 + rand(30)] = r end end  -- sparse ints above L (hash)
  if rand(2) == 0 then for i = 1, rand(40) do t[#t + 1] = r end end            -- grow back over them (migration)
  if rand(3) == 0 then for i = 1, rand(8) do t[rand(MAXK) + 1] = nil end end
  full_check(t, r, "PRE")
  if fail then return end
  -- a paused traversal
  local live, n = universe(t)
  local seen, cnt, k = {}, 0, nil
  local pauseat = rand(n + 1)
  local deleted = {}
  local ok, err = pcall(function()
    while true do
      local v
      k, v = next(t, k)
      if k == nil then break end
      cnt = cnt + 1
      if cnt > (UNDEF and 20 * (n + 50) or n * 4 + 10) then report("RUNAWAY", r) return end
      if not UNDEF then
        if seen[k] then report("DUP " .. tostring(k), r) end
        if rawget(t, k) == nil then report("DEAD " .. tostring(k), r) end
      end
      seen[k] = true
      if cnt == pauseat then
        local how = rand(4)
        if how == 0 then t[k] = nil; deleted[k] = true end                                 -- delete current
        if how <= 1 then local s = rand(#t + 1); for i = 1, s do local kk = #t; if kk > 0 then t[kk] = nil; deleted[kk] = true end end end  -- shrink partway (existing keys)
        if how == 2 then for i = 1, rand(5) do local kk = rand(MAXK) + 1; if t[kk] ~= nil then t[kk] = nil; deleted[kk] = true end end end
        if how == 3 then for kk in pairs(live) do if rand(3) == 0 and t[kk] ~= nil then t[kk] = -1 end end end -- reassign existing
        if UNDEF then
          local L = #t
          for i = 1, rand(5) do t[L + 2 + rand(20)] = r end         -- sparse writes into the ghost range
          for i = 1, rand(25) do t[#t + 1] = r end                   -- grow back over them
          if type(k) == "number" and rand(2) == 0 then t[k] = r end  -- re-insert the (possibly ghost) cursor key
        end
      end
    end
  end)
  if not ok then
    if not (UNDEF and tostring(err):find("invalid key to 'next'")) then report("ERROR " .. tostring(err), r) end
  end
  if not UNDEF then
    for kk in pairs(live) do if not seen[kk] and not deleted[kk] then report("MISSED " .. tostring(kk), r) end end
  end
  full_check(t, r, "POST")
  if fail then return end
end
print("DONE")
