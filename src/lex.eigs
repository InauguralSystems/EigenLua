# EigenLua lexer: Lua 5.4 source text -> token lists (manual 3.1).
# lua_lex returns {"t": types, "v": values, "l": lines, "f": float-literal flags,
# "z": NUL positions of each string token, or 0}. Token type is "name", "string", "number",
# "eof", or the keyword / punctuation text itself. A lexical error raises
# ["SYNTAX", line, message].

define lex_err(line, msg) as:
    throw of (["SYNTAX", line, msg])

define lex_is_alpha(c) as:
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

define lex_is_digit(c) as:
    return c >= 48 and c <= 57

define lex_is_xdigit(c) as:
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)

define lex_xval(c) as:
    if c >= 48 and c <= 57:
        return c - 48
    if c >= 97 and c <= 102:
        return c - 87
    return c - 55

# UTF-8 encoding of a code point up to 2^31 (Lua's \u{XXX}, manual 3.1).
define lex_utf8(cp) as:
    if cp < 128:
        return [cp]
    local mfb is 63
    local tmp is []
    local go is 1
    loop while go:
        list_insert_at of [tmp, 0, 128 + (cp % 64)]
        cp is floor of (cp / 64)
        mfb is floor of (mfb / 2)
        go is cp > mfb
    local first is bit_and of [bit_or of [bit_shl of [bit_not of (mfb), 1], cp], 255]
    list_insert_at of [tmp, 0, first]
    return tmp

define lua_lex(src) as:
    local kw is {"and": 1, "break": 1, "do": 1, "else": 1, "elseif": 1, "end": 1, "false": 1, "for": 1, "function": 1, "goto": 1, "if": 1, "in": 1, "local": 1, "nil": 1, "not": 1, "or": 1, "repeat": 1, "return": 1, "then": 1, "true": 1, "until": 1, "while": 1}
    local T is []
    local V is []
    local Ln is []
    local Fl is []
    local Z is []
    # raw text of number and string tokens (lexer.c txtToken), else null
    local Rw is []
    local n is len of src
    local i is 0
    local line is 1
    # A lexical error becomes a "lexerr" token: the parser raises it when it
    # reaches that token, since Lua lexes on demand and an earlier syntax
    # error wins.
    try:
        loop while i < n:
            local c is ord of src[i]
            if c == 10 or c == 13:
                # \n, \r, \r\n and \n\r each count as one line break
                # (llex.c inclinenumber)
                line is line + 1
                i is i + 1
                if i < n and (src[i] == "\n" or src[i] == "\r") and (ord of src[i]) != c:
                    i is i + 1
            elif c == 32 or c == 9 or c == 11 or c == 12:
                i is i + 1
            elif c == 45 and i + 1 < n and src[i + 1] == "-":
                # comment
                i is i + 2
                local lv is -1
                if i < n and src[i] == "[":
                    lv is lex_long_level of [src, i]
                if lv >= 0:
                    local r is lex_long of [src, i, lv, line, 1]
                    i is r[0]
                    line is r[1]
                else:
                    loop while i < n and src[i] != "\n" and src[i] != "\r":
                        i is i + 1
            elif lex_is_alpha of c:
                local j is i
                loop while j < n and (lex_is_alpha of (ord of src[j]) or lex_is_digit of (ord of src[j])):
                    j is j + 1
                local w is src[i:j]
                if has_key of [kw, w]:
                    append of [T, w]
                else:
                    append of [T, "name"]
                append of [V, w]
                append of [Ln, line]
                append of [Fl, 0]
                append of [Z, 0]
                append of [Rw, null]
                i is j
            elif lex_is_digit of c or (c == 46 and i + 1 < n and lex_is_digit of (ord of src[i + 1])):
                local r is lex_number of [src, i, line]
                append of [T, "number"]
                append of [V, r[1]]
                append of [Rw, src[i:r[0]]]
                append of [Ln, line]
                append of [Fl, r[2]]
                append of [Z, 0]
                i is r[0]
            elif c == 34 or c == 39:
                local r is lex_string of [src, i, line]
                append of [T, "string"]
                append of [V, r[1]]
                append of [Rw, src[i] + r[1] + src[i]]
                append of [Ln, line]
                append of [Fl, 0]
                append of [Z, r[3]]
                i is r[0]
                line is r[2]
            elif c == 91 and lex_long_level of [src, i] >= 0:
                local lv is lex_long_level of [src, i]
                local sl is line
                local r is lex_long of [src, i, lv, line, 0]
                append of [T, "string"]
                append of [V, r[2]]
                append of [Rw, src[i:r[0]]]
                append of [Ln, sl]
                append of [Fl, 0]
                append of [Z, r[3]]
                i is r[0]
                line is r[1]
            else:
                local p3 is src[i:min of [i + 3, n]]
                local p2 is src[i:min of [i + 2, n]]
                local op is ""
                if src[i] == "[" and i + 1 < n and src[i + 1] == "=":
                    # llex.c skip_sep: '[' and '='s with no second '['
                    local k2 is i + 1
                    loop while k2 < n and src[k2] == "=":
                        k2 is k2 + 1
                    lex_err of [line, "invalid long string delimiter near '" + src[i:k2] + "'"]
                if p3 == "...":
                    op is p3
                elif p2 == "==" or p2 == "~=" or p2 == "<=" or p2 == ">=" or p2 == "//" or p2 == "::" or p2 == "<<" or p2 == ">>" or p2 == "..":
                    op is p2
                elif index_of of ["+-*/%^#&~|<>=(){}[];:,.", src[i]] >= 0:
                    op is src[i]
                else:
                    # any other byte is a token of its own; the parser rejects it
                    op is src[i]
                append of [T, op]
                append of [V, op]
                append of [Ln, line]
                append of [Fl, 0]
                append of [Z, 0]
                append of [Rw, null]
                i is i + len of op
    catch e:
        if type of e != "list" or e[0] != "SYNTAX":
            throw of (e)
        append of [T, "lexerr"]
        append of [V, e[2]]
        append of [Ln, e[1]]
        append of [Fl, 0]
        append of [Z, 0]
        append of [Rw, null]
    append of [T, "eof"]
    append of [V, "<eof>"]
    append of [Ln, line]
    append of [Fl, 0]
    append of [Z, 0]
    append of [Rw, null]
    return {"t": T, "v": V, "l": Ln, "f": Fl, "z": Z, "r": Rw}

# Level of a long bracket opening at i ("[" "="* "["), or -1.
define lex_long_level(src, i) as:
    local j is i + 1
    local n is len of src
    loop while j < n and src[j] == "=":
        j is j + 1
    if j < n and src[j] == "[":
        return j - i - 1
    return -1

# Read a long bracket starting at i with level lv. Returns
# [next_index, line, text, has_nul]. The first newline is skipped.
define lex_long(src, i, lv, line, is_comment) as:
    local n is len of src
    local j is i + lv + 2
    local startline is line
    if j < n and (src[j] == "\r" or src[j] == "\n"):
        local c0 is src[j]
        j is j + 1
        if j < n and (src[j] == "\r" or src[j] == "\n") and src[j] != c0:
            j is j + 1
        line is line + 1
    local parts is []
    local seg is j
    loop while 1:
        if j >= n:
            local wht is "string"
            if is_comment:
                wht is "comment"
            lex_err of [line, "unfinished long " + wht + " (starting at line " + (str of startline) + ") near <eof>"]
        local ch is src[j]
        if ch == "]":
            local k is j + 1
            loop while k < n and src[k] == "=":
                k is k + 1
            if k < n and src[k] == "]" and k - j - 1 == lv:
                append of [parts, src[seg:j]]
                return [k + 1, line, join of [parts, ""], 0]
            j is j + 1
        elif ch == "\r" or ch == "\n":
            append of [parts, src[seg:j]]
            append of [parts, "\n"]
            j is j + 1
            if j < n and (src[j] == "\r" or src[j] == "\n") and src[j] != ch:
                j is j + 1
            line is line + 1
            seg is j
        else:
            j is j + 1

# Numeral at i (llex.c read_numeral). Returns [next_index, value, is_float].
# Like Lua, it takes every hex digit and '.', an exponent mark with its
# sign, and one letter touching the end, then converts the whole text or
# reports it as malformed. Hex integers wrap modulo 2^64 in Lua; that wrap
# is not representable on one double and is left to the value (an
# EigenScript gap, see LEDGER.md).
define lex_number(src, i, line) as:
    local n is len of src
    local j is i + 1
    local e0 is "e"
    local e1 is "E"
    if src[i] == "0" and j < n and (src[j] == "x" or src[j] == "X"):
        j is j + 1
        e0 is "p"
        e1 is "P"
    loop while j < n:
        if src[j] == e0 or src[j] == e1:
            j is j + 1
            if j < n and (src[j] == "-" or src[j] == "+"):
                j is j + 1
        elif lex_is_xdigit of (ord of src[j]) or src[j] == ".":
            j is j + 1
        else:
            break
    if j < n and lex_is_alpha of (ord of src[j]):
        j is j + 1
    local text is src[i:j]
    local r is lex_str2num of (text)
    if r == null:
        lex_err of [line, "malformed number near '" + text + "'"]
    return [j, r[0], r[1]]

# lobject.c l_str2int/l_str2d on a numeral's whole text: [value, is_float]
# or null.
define lex_str2num(s) as:
    local n is len of s
    local j is 0
    local isf is 0
    if n > 1 and s[0] == "0" and (s[1] == "x" or s[1] == "X"):
        j is 2
        local mant is 0
        local exp is 0
        local any is 0
        loop while j < n and lex_is_xdigit of (ord of s[j]):
            mant is mant * 16 + (lex_xval of (ord of s[j]))
            any is 1
            j is j + 1
        if j < n and s[j] == ".":
            isf is 1
            j is j + 1
            loop while j < n and lex_is_xdigit of (ord of s[j]):
                mant is mant * 16 + (lex_xval of (ord of s[j]))
                exp is exp - 4
                any is 1
                j is j + 1
        if any == 0:
            return null
        if j < n and (s[j] == "p" or s[j] == "P"):
            isf is 1
            j is j + 1
            local sg is 1
            if j < n and (s[j] == "+" or s[j] == "-"):
                if s[j] == "-":
                    sg is -1
                j is j + 1
            if j >= n or not (lex_is_digit of (ord of s[j])):
                return null
            local e is 0
            loop while j < n and lex_is_digit of (ord of s[j]):
                e is e * 10 + (ord of s[j]) - 48
                j is j + 1
            exp is exp + sg * e
        if j != n:
            return null
        local val is mant
        if exp != 0:
            val is mant * (pow of [2, exp])
        return [val, isf]
    local nd is 0
    loop while j < n and lex_is_digit of (ord of s[j]):
        j is j + 1
        nd is nd + 1
    if j < n and s[j] == ".":
        isf is 1
        j is j + 1
        loop while j < n and lex_is_digit of (ord of s[j]):
            j is j + 1
            nd is nd + 1
    if nd == 0:
        return null
    if j < n and (s[j] == "e" or s[j] == "E"):
        isf is 1
        j is j + 1
        if j < n and (s[j] == "+" or s[j] == "-"):
            j is j + 1
        if j >= n or not (lex_is_digit of (ord of s[j])):
            return null
        loop while j < n and lex_is_digit of (ord of s[j]):
            j is j + 1
    if j != n:
        return null
    local text is s
    if text[0] == ".":
        text is "0" + text
    if text[len of text - 1] == ".":
        text is text + "0"
    local v is num of text
    if isf == 0 and v >= 9223372036854775808:
        isf is 1
    return [v, isf]

# The "near" text of a lexical error inside a string (llex.c txtToken on
# the save buffer): the delimiter, the string read so far, then the raw
# characters of the escape being read; %s stops at a NUL byte.
define lex_strnear(q, parts, raw) as:
    local s is q + (join of [parts, ""])
    local z is index_of of [s, chr of 1]
    if z >= 0:
        s is s[0:z]
    return "'" + s + raw + "'"

# llex.c esccheck: when it fails, the current character (unless at the
# end of the source) joins the near text.
define lex_escerr(src, j, line, q, parts, raw, msg) as:
    if j < len of src:
        raw is raw + src[j]
    lex_err of [line, msg + " near " + (lex_strnear of [q, parts, raw])]

# Short string at i (llex.c read_string). Returns [next_index, text, line,
# nuls]. A NUL byte cannot live in an EigenScript string (NUL-terminated,
# EigenScript gap): it is held as byte 1 in text and nuls lists its
# positions (0 when there is none); the emitter builds the literal with
# str_from_bytes, the direct translation, which ends the string at the
# first NUL.
define lex_string(src, i, line) as:
    local n is len of src
    local q is src[i]
    local j is i + 1
    local parts is []
    local seg is j
    local nul is 0
    loop while 1:
        if j >= n:
            lex_err of [line, "unfinished string near <eof>"]
        local ch is src[j]
        if ch == q:
            append of [parts, src[seg:j]]
            return [j + 1, join of [parts, ""], line, nul]
        if ch == "\n" or ch == "\r":
            append of [parts, src[seg:j]]
            lex_err of [line, "unfinished string near " + (lex_strnear of [q, parts, ""])]
        if ch == "\\":
            append of [parts, src[seg:j]]
            j is j + 1
            local bytes is []
            local e is ""
            if j < n:
                e is src[j]
            if j >= n:
                # the next round reports the unfinished string
                null
            elif e == "n":
                bytes is [10]
                j is j + 1
            elif e == "t":
                bytes is [9]
                j is j + 1
            elif e == "a":
                bytes is [7]
                j is j + 1
            elif e == "b":
                bytes is [8]
                j is j + 1
            elif e == "f":
                bytes is [12]
                j is j + 1
            elif e == "v":
                bytes is [11]
                j is j + 1
            elif e == "r":
                bytes is [13]
                j is j + 1
            elif e == "\\" or e == "\"" or e == "'":
                bytes is [ord of e]
                j is j + 1
            elif e == "\n" or e == "\r":
                bytes is [10]
                j is j + 1
                if j < n and (src[j] == "\n" or src[j] == "\r") and src[j] != e:
                    j is j + 1
                line is line + 1
            elif e == "x":
                j is j + 1
                if j >= n or not (lex_is_xdigit of (ord of src[j])):
                    lex_escerr of [src, j, line, q, parts, "\\x", "hexadecimal digit expected"]
                if j + 1 >= n or not (lex_is_xdigit of (ord of src[j + 1])):
                    lex_escerr of [src, j + 1, line, q, parts, "\\x" + src[j], "hexadecimal digit expected"]
                bytes is [(lex_xval of (ord of src[j])) * 16 + (lex_xval of (ord of src[j + 1]))]
                j is j + 2
            elif e == "z":
                j is j + 1
                loop while j < n and (src[j] == " " or src[j] == "\t" or src[j] == "\n" or src[j] == "\r" or (ord of src[j]) == 12 or (ord of src[j]) == 11):
                    if src[j] == "\n" or src[j] == "\r":
                        local c0 is src[j]
                        j is j + 1
                        if j < n and (src[j] == "\n" or src[j] == "\r") and src[j] != c0:
                            j is j + 1
                        line is line + 1
                    else:
                        j is j + 1
            elif e == "u":
                j is j + 1
                if j >= n or src[j] != "{":
                    lex_escerr of [src, j, line, q, parts, "\\u", "missing '{'"]
                j is j + 1
                if j >= n or not (lex_is_xdigit of (ord of src[j])):
                    lex_escerr of [src, j, line, q, parts, "\\u{", "hexadecimal digit expected"]
                local cp is lex_xval of (ord of src[j])
                local raw is "\\u{" + src[j]
                j is j + 1
                loop while j < n and lex_is_xdigit of (ord of src[j]):
                    if cp > 134217727:
                        lex_escerr of [src, j, line, q, parts, raw, "UTF-8 value too large"]
                    cp is cp * 16 + (lex_xval of (ord of src[j]))
                    raw is raw + src[j]
                    j is j + 1
                if j >= n or src[j] != "}":
                    lex_escerr of [src, j, line, q, parts, raw, "missing '}'"]
                j is j + 1
                bytes is lex_utf8 of (cp)
            elif lex_is_digit of (ord of e):
                local v is 0
                local k is 0
                local raw2 is "\\"
                loop while k < 3 and j < n and lex_is_digit of (ord of src[j]):
                    v is v * 10 + (ord of src[j]) - 48
                    raw2 is raw2 + src[j]
                    j is j + 1
                    k is k + 1
                if v > 255:
                    lex_escerr of [src, j, line, q, parts, raw2, "decimal escape too large"]
                bytes is [v]
            else:
                lex_escerr of [src, j, line, q, parts, "\\", "invalid escape sequence"]
            for b in bytes:
                if b == 0:
                    if type of nul != "list":
                        nul is []
                    append of [nul, len of (join of [parts, ""])]
                    append of [parts, chr of 1]
                else:
                    append of [parts, chr of b]
            seg is j
        else:
            j is j + 1
