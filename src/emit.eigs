# EigenLua emitter: Lua AST -> EigenScript source.
#
# Two passes. The resolver binds every Name to a local variable record (or to
# _ENV, a global) and marks the locals that an inner function captures. The
# emitter then writes one EigenScript program:
#   - every Lua function becomes a top-level factory F<id>(U) whose body binds
#     the function's upvalue cells from U and defines f<id>(A); creating a
#     closure is `F<id> of ([cells])`, so each closure gets the cells live at
#     its creation (fresh per loop iteration);
#   - a captured local is a cell, a one-element list `c<id>`; any other local
#     is a plain EigenScript local `v<id>`; every name is unique, so Lua block
#     scoping and shadowing cannot meet EigenScript's outward-mutable `is`;
#   - a Lua function takes one list A of arguments and returns a list of
#     results; every operation that can fail or dispatch a metamethod is a
#     runtime call carrying a site id, and the site table maps the id to the
#     Lua line and the variable descriptions Lua puts in its messages.
# A construct the emitter does not handle raises ["UNSUP", what, line].

define em_unsup(wht, line) as:
    throw of (["UNSUP", wht, line])

# ---------------------------------------------------------------- resolver

define rs_new_var(R, name, fn, attr) as:
    R.G.vid is R.G.vid + 1
    return {"id": R.G.vid, "name": name, "fn": fn, "cap": 0, "attr": attr}

define rs_declare(R, v) as:
    local sc is R.scopes[len of R.scopes - 1]
    sc[v.name] is v

define rs_push(R) as:
    append of [R.scopes, {}]

define rs_pop(R) as:
    list_truncate of [R.scopes, len of R.scopes - 1]

define rs_lookup(R, name) as:
    local i is len of R.scopes - 1
    loop while i >= 0:
        local sc is R.scopes[i]
        local v is sc[name]
        if v != null:
            return v
        i is i - 1
    return null

# Mark v captured and thread it through every function from fn up to v.fn.
define rs_capture(R, v, fn, line) as:
    v.cap is 1
    local g is fn
    loop while g != null and g.id != v.fn.id:
        local key is str of v.id
        if not (has_key of [g.freeidx, key]):
            if len of g.free >= 255:
                # lparser.c newupvalue: MAXUPVAL (255)
                local wh is "main function"
                if g.main != 1:
                    wh is "function at line " + (str of g.line)
                throw of (["SYNTAX", line, "too many upvalues (limit is 255) in " + wh + " near '" + v.name + "'"])
            g.freeidx[key] is len of g.free
            append of [g.free, v]
        g is g.parent

define rs_func(R, fn, parent) as:
    R.G.fid is R.G.fid + 1
    fn.id is R.G.fid
    fn.parent is parent
    fn.free is []
    fn.freeidx is {}
    local saved is R.fn
    R.fn is fn
    rs_push of (R)
    local pv is []
    for p in fn.params:
        local v is rs_new_var of [R, p, fn, ""]
        rs_declare of [R, v]
        append of [pv, v]
    fn.pvars is pv
    if parent == null:
        # _ENV is a variable of the main function: every global name
        # indexes the _ENV visible where it appears (manual 2.2)
        local ev is rs_new_var of [R, "_ENV", fn, ""]
        ev.implicit is 1
        rs_declare of [R, ev]
        fn.envvar is ev
    rs_block of [R, fn.body]
    rs_pop of (R)
    R.fn is saved

define rs_block(R, stats) as:
    rs_push of (R)
    for s in stats:
        rs_stat of [R, s]
    rs_pop of (R)

define rs_stat(R, s) as:
    local k is s.k
    if k == "Local":
        for e in s.exprs:
            rs_expr of [R, e]
        local vs is []
        local i is 0
        for nm in s.names:
            local atb is s.attribs[i]
            local v is rs_new_var of [R, nm, R.fn, atb]
            append of [vs, v]
            i is i + 1
        for v in vs:
            rs_declare of [R, v]
        s.vars is vs
        # lparser/lcode keep a compile-time value for eligible <const>
        # locals.  Retain the initializer so debug-name generation can see
        # the same folded key that selects OP_GETFIELD/OP_GETI.
        local ci is 0
        for v in vs:
            if v.attr == "const" and ci < len of s.exprs:
                v.cinit is s.exprs[ci]
            ci is ci + 1
    elif k == "LocalFunction":
        local v is rs_new_var of [R, s.name, R.fn, ""]
        rs_declare of [R, v]
        s.var is v
        rs_func of [R, s.func, R.fn]
    elif k == "Assign":
        for t in s.targets:
            rs_expr of [R, t]
            if t.k == "Name" and t.var != null and t.var.attr != "":
                throw of (["SYNTAX", s.line, "attempt to assign to const variable '" + t.n + "'"])
        for e in s.exprs:
            rs_expr of [R, e]
    elif k == "CallStat":
        rs_expr of [R, s.e]
    elif k == "Do":
        rs_block of [R, s.body]
    elif k == "While":
        rs_expr of [R, s.cond]
        rs_block of [R, s.body]
    elif k == "Repeat":
        # the condition sees the body's locals
        rs_push of (R)
        for b in s.body:
            rs_stat of [R, b]
        rs_expr of [R, s.cond]
        rs_pop of (R)
    elif k == "If":
        # in source order (cond, block, cond, block): upvalues are numbered
        # by first reference
        local ci is 0
        for c in s.conds:
            rs_expr of [R, c]
            rs_block of [R, s.blocks[ci]]
            ci is ci + 1
        if s["else"] != null:
            rs_block of [R, s["else"]]
    elif k == "NumFor":
        rs_expr of [R, s.a]
        rs_expr of [R, s.b]
        if s.c != null:
            rs_expr of [R, s.c]
        rs_push of (R)
        local v is rs_new_var of [R, s.var, R.fn, ""]
        rs_declare of [R, v]
        s.v is v
        rs_block of [R, s.body]
        rs_pop of (R)
    elif k == "GenFor":
        for e in s.exprs:
            rs_expr of [R, e]
        rs_push of (R)
        local vs is []
        for nm in s.names:
            local v is rs_new_var of [R, nm, R.fn, ""]
            rs_declare of [R, v]
            append of [vs, v]
        s.vars is vs
        rs_block of [R, s.body]
        rs_pop of (R)
    elif k == "Return":
        for e in s.exprs:
            rs_expr of [R, e]
    elif k == "Break":
        null
    elif k == "Goto" or k == "Label":
        R.fn.hasgoto is 1
    else:
        throw of (["INTERNAL", "unknown statement " + k])

define rs_expr(R, e) as:
    local k is e.k
    if k == "Name":
        local v is rs_lookup of [R, e.n]
        e.var is v
        if v != null and v.fn.id != R.fn.id:
            rs_capture of [R, v, R.fn, e.line]
        if v == null:
            local ev is rs_lookup of [R, "_ENV"]
            e.envvar is ev
            if ev.fn.id != R.fn.id:
                rs_capture of [R, ev, R.fn, e.line]
    elif k == "Index":
        rs_expr of [R, e.o]
        rs_expr of [R, e.key]
    elif k == "Call":
        rs_expr of [R, e.f]
        for a in e.args:
            rs_expr of [R, a]
    elif k == "MCall":
        rs_expr of [R, e.o]
        for a in e.args:
            rs_expr of [R, a]
    elif k == "Paren":
        rs_expr of [R, e.e]
    elif k == "Bin":
        rs_expr of [R, e.a]
        rs_expr of [R, e.b]
    elif k == "Un":
        rs_expr of [R, e.a]
    elif k == "Table":
        for it in e.items:
            if it.t == "kv":
                rs_expr of [R, it.key]
            rs_expr of [R, it.e]
    elif k == "Func":
        rs_func of [R, e, R.fn]

# ---------------------------------------------------------------- emitter

define em_line(E, text) as:
    append of [E.out, E.ind + text]

define em_indent(E) as:
    E.ind is E.ind + "    "

define em_dedent(E) as:
    E.ind is E.ind[4:]

define em_tmp(E) as:
    E.G.tmp is E.G.tmp + 1
    return "t" + (str of E.G.tmp)

# A site is [line, descriptor_a, descriptor_b]; its id indexes the table.
define em_site(E, line, da, db) as:
    append of [E.G.sites, [line, da, db]]
    if E.G.chunk:
        return "S[" + (str of (len of E.G.sites - 1)) + "]"
    return str of (E.G.sitebase + len of E.G.sites - 1)

# Lua's variable description for an operand, as in its error messages.
define em_desc(E, e) as:
    if e.k == "Name":
        if e.var == null:
            return "global '" + e.n + "'"
        if e.var.fn.id != E.fn.id:
            return "upvalue '" + e.n + "'"
        return "local '" + e.n + "'"
    if e.k == "Paren":
        return em_desc of [E, e.e]
    # ldebug.c getobjname: OP_GETFIELD names its key, OP_GETI is "integer
    # index", any other key (rname) is "?"
    if e.k == "Index":
        local fk is em_folded_key of (e.key)
        if fk != null and fk[0] == "str":
            return "field '" + fk[1] + "'"
        if fk != null and fk[0] == "int" and fk[1] >= 0 and fk[1] <= 255:
            return "field 'integer index'"
        return "field '?'"
    if e.k == "Str":
        return "constant '" + e.v + "'"
    return ""

# The constant folding relevant to getobjname.  This deliberately mirrors
# lcode.c's conservative rule rather than evaluating through the runtime:
# failures, integer overflow, NaN, and floating negative zero must remain RK
# operands.  Integer negative zero is simply integer zero.
# The returned tag preserves Lua's integer/float subtype because only an
# integer in OP_GETI's byte-sized range receives the "integer index" name.
define em_folded_key(e) as:
    if e.k == "Str":
        return ["str", e.v]
    if e.k == "Num":
        if e.fl:
            return ["float", e.v]
        return ["int", e.v]
    if e.k == "Paren":
        return em_folded_key of (e.e)
    if e.k == "Name" and e.var != null and e.var.attr == "const" and e.var.cinit != null:
        return em_folded_key of (e.var.cinit)
    if e.k == "Un" and e.op == "-":
        local a is em_folded_key of (e.a)
        if a == null or a[0] == "str" or (a[0] == "float" and a[1] == 0):
            return null
        return [a[0], 0 - a[1]]
    if e.k == "Un" and e.op == "~":
        local ua is em_folded_key of (e.a)
        if ua == null or ua[0] == "str" or ua[1] != floor of ua[1] or ua[1] < -9223372036854775808 or ua[1] >= 9223372036854775808:
            return null
        return ["int", bit_not of (ua[1])]
    if e.k == "Bin":
        local a is em_folded_key of (e.a)
        local b is em_folded_key of (e.b)
        if a == null or b == null or a[0] == "str" or b[0] == "str":
            return null
        local fl is a[0] == "float" or b[0] == "float" or e.op == "/"
        local v is null
        if e.op == "+":
            v is a[1] + b[1]
        elif e.op == "-":
            v is a[1] - b[1]
        elif e.op == "*":
            v is a[1] * b[1]
        elif e.op == "%" and b[1] != 0:
            v is a[1] % b[1]
            if v != 0 and (v < 0) != (b[1] < 0):
                v is v + b[1]
        elif e.op == "//" and b[1] != 0:
            v is floor of (a[1] / b[1])
        elif e.op == "&" or e.op == "|" or e.op == "~" or e.op == "<<" or e.op == ">>":
            # luaV_tointegerns: bitwise folding accepts integral floats but
            # never performs a lossy conversion.
            if a[1] != floor of a[1] or b[1] != floor of b[1] or a[1] < -9223372036854775808 or a[1] >= 9223372036854775808 or b[1] < -9223372036854775808 or b[1] >= 9223372036854775808:
                return null
            fl is false
            if e.op == "&":
                v is bit_and of [a[1], b[1]]
            elif e.op == "|":
                v is bit_or of [a[1], b[1]]
            elif e.op == "~":
                v is bit_xor of [a[1], b[1]]
            elif b[1] <= -64 or b[1] >= 64:
                v is 0
            elif e.op == "<<" and b[1] >= 0:
                v is bit_shl of [a[1], b[1]]
            elif e.op == "<<":
                v is bit_shr of [a[1], 0 - b[1]]
            elif b[1] >= 0:
                v is bit_shr of [a[1], b[1]]
            else:
                v is bit_shl of [a[1], 0 - b[1]]
        else:
            return null
        # All integer values EigenScript can represent exactly are safely
        # inside Lua's int64 range.  Reject rounded arithmetic as overflow.
        if not fl and (v > 9007199254740991 or v < -9007199254740991):
            return null
        if fl:
            return ["float", v]
        return ["int", v]
    return null

# How Lua names the _ENV a global name indexes, for an index error: the
# main chunk's _ENV is an upvalue.
define em_envdesc(E, v) as:
    if v.implicit == 1 or v.fn.id != E.fn.id:
        return "upvalue '_ENV'"
    return "local '_ENV'"

# A captured variable's cell, a one-element list.
define em_cell(E, code) as:
    return "[" + code + "]"

define em_var_ref(v) as:
    if v.cap:
        return "c" + (str of v.id) + "[0]"
    return "v" + (str of v.id)

define em_strlit(s) as:
    local parts is ["\""]
    local n is len of s
    local seg is 0
    local i is 0
    loop while i < n:
        local c is s[i]
        if c == "\\" or c == "\"" or c == "\n":
            append of [parts, s[seg:i]]
            if c == "\n":
                append of [parts, "\\n"]
            else:
                append of [parts, "\\" + c]
            seg is i + 1
        i is i + 1
    append of [parts, s[seg:n]]
    append of [parts, "\""]
    return join of [parts, ""]

# A string literal holding NUL bytes is built from its bytes with
# str_from_bytes, the direct translation; EigenScript ends a string at its
# first NUL (gaps/nul-in-string.eigs), so such a row diverges.
define em_nulstr(e) as:
    local s is e.v
    local bs is []
    for i in range of (len of s):
        append of [bs, str of (ord of s[i])]
    for p in e.z:
        bs[p] is "0"
    return "(str_from_bytes of (" + (em_listlit of (bs)) + "))"

define em_numlit(E, v) as:
    local s is str of v
    if (num of s) == v and index_of of [s, "e"] < 0 and index_of of [s, "n"] < 0:
        if v < 0:
            return "(" + s + ")"
        return s
    if (num of s) == v and index_of of [s, "n"] < 0:
        return "(num of \"" + s + "\")"
    local b is f64_to_bytes of v
    local bs is []
    for x in b:
        append of [bs, str of x]
    return "(f64_from_bytes of ([" + (join of [bs, ", "]) + "]))"

define em_is_multi(e) as:
    return e.k == "Call" or e.k == "MCall" or e.k == "Vararg"

# Pure code: reading it later gives the same value as reading it now,
# whatever statements run in between.
define em_pure(e) as:
    local k is e.k
    if k == "Nil" or k == "True" or k == "False" or k == "Num" or k == "Str":
        return 1
    if k == "Name" and e.var != null and e.var.cap == 0:
        return 1
    return 0

# Compile operands left to right. When a later operand hoists statements, an
# earlier impure operand is pinned into a temp at its own position, so Lua's
# left-to-right order of evaluation survives the hoisting.
define em_operands(E, exprs) as:
    local codes is []
    local pos is []
    local pures is []
    for e in exprs:
        local c is em_expr of [E, e]
        append of [codes, c]
        append of [pos, len of E.out]
        append of [pures, (em_pure of (e)) or (em_is_tmp of (c))]
    local n is len of codes
    local i is n - 2
    loop while i >= 0:
        if pures[i] == 0 and pos[i] < len of E.out and pos[i] < pos[n - 1]:
            local t is em_tmp of (E)
            list_insert_at of [E.out, pos[i], E.ind + "local " + t + " is " + codes[i]]
            codes[i] is t
        i is i - 1
    return codes

define em_is_tmp(c) as:
    if len of c < 2 or c[0] != "t":
        return 0
    local i is 1
    loop while i < len of c:
        local ch is ord of c[i]
        if ch < 48 or ch > 57:
            return 0
        i is i + 1
    return 1

# Expression list -> code for a list of all its values (last one expanded).
define em_explist(E, exprs) as:
    local n is len of exprs
    if n == 0:
        return "[]"
    local last is exprs[n - 1]
    if not (em_is_multi of (last)):
        local codes is em_operands of [E, exprs]
        return em_listlit of (codes)
    local front is list_slice of [exprs, 0, n - 1]
    local all is em_operands_multi of [E, front, last]
    local codes2 is all[0]
    local tail is all[1]
    if len of codes2 == 0:
        return tail
    return "(concat of [" + (em_listlit of (codes2)) + ", " + tail + "])"

# Operands front (single values) then the multi-valued last expression.
define em_operands_multi(E, front, last) as:
    local codes is []
    local pos is []
    local pures is []
    for e in front:
        local c is em_expr of [E, e]
        append of [codes, c]
        append of [pos, len of E.out]
        append of [pures, (em_pure of (e)) or (em_is_tmp of (c))]
    local tail is em_multi of [E, last]
    local n is len of codes
    local i is n - 1
    loop while i >= 0:
        if pures[i] == 0 and pos[i] < len of E.out:
            local t is em_tmp of (E)
            list_insert_at of [E.out, pos[i], E.ind + "local " + t + " is " + codes[i]]
            codes[i] is t
        i is i - 1
    return [codes, tail]

# A list literal, written as one (EigenScript refuses one of more than 1024
# elements: gaps/list-literal-cap.eigs; such a row diverges).
define em_listlit(codes) as:
    return "[" + (join of [codes, ", "]) + "]"

# Multi-valued expression -> code for the list of its values.
define em_multi(E, e) as:
    if e.k == "Vararg":
        return "V"
    if e.k == "Call" or e.k == "MCall":
        return em_call of [E, e, 1]
    return "[" + (em_expr of [E, e]) + "]"

# Call -> a temp holding the list of results (want_list) or its first value.
define em_call(E, e, want_list) as:
    local t is em_tmp of (E)
    local fnname is "lr_call1"
    if want_list:
        fnname is "lr_call"
    if e.k == "MCall":
        # Lua evaluates the receiver, looks the method up, then evaluates the
        # arguments; an index error names the receiver, a call error the method
        local site is em_site of [E, e.line, em_desc of [E, e.o], "method '" + e.m + "'"]
        local oc is em_expr of [E, e.o]
        if not (em_pure of (e.o)) and not (em_is_tmp of (oc)):
            local t0 is em_tmp of (E)
            em_line of [E, "local " + t0 + " is " + oc]
            oc is t0
        local tm is em_tmp of (E)
        em_line of [E, "local " + tm + " is lr_index of [" + oc + ", " + (em_strlit of (e.m)) + ", " + site + "]"]
        local args is em_explist of [E, e.args]
        local mn is "lr_mcall1"
        if want_list:
            mn is "lr_mcall"
        em_line of [E, "local " + t + " is " + mn + " of [" + tm + ", " + oc + ", " + args + ", " + site + "]"]
        return t
    local site is em_site of [E, e.line, em_desc of [E, e.f], ""]
    local fc is em_expr of [E, e.f]
    local fpos is len of E.out
    local args is em_explist of [E, e.args]
    if not (em_pure of (e.f)) and not (em_is_tmp of (fc)) and fpos < len of E.out:
        local t0 is em_tmp of (E)
        list_insert_at of [E.out, fpos, E.ind + "local " + t0 + " is " + fc]
        fc is t0
    em_line of [E, "local " + t + " is " + fnname + " of [" + fc + ", " + args + ", " + site + "]"]
    return t

define em_binop_fn(op) as:
    local m is {"+": "lr_add", "-": "lr_sub", "*": "lr_mul", "/": "lr_div", "%": "lr_mod", "//": "lr_idiv", "^": "lr_pow", "..": "lr_concat", "==": "lr_eq", "~=": "lr_ne", "<": "lr_lt", "<=": "lr_le", ">": "lr_gt", ">=": "lr_ge", "&": "lr_band", "|": "lr_bor", "~": "lr_bxor", "<<": "lr_shl", ">>": "lr_shr"}
    return m[op]

# Single-valued expression -> EigenScript expression code (may hoist). A
# deeply nested Lua expression is a deeply nested EigenScript expression
# (EigenScript refuses deep nesting: gaps/nesting-limits.eigs).
define em_expr(E, e) as:
    local k is e.k
    if k == "Nil":
        return "null"
    if k == "True":
        return "true"
    if k == "False":
        return "false"
    if k == "Num":
        return em_numlit of [E, e.v]
    if k == "Str":
        if e.z:
            return em_nulstr of (e)
        return em_strlit of (e.v)
    if k == "Vararg":
        return "(lr_at of [V, 0])"
    if k == "Name":
        if e.var != null:
            return em_var_ref of (e.var)
        if e.n == "_ENV":
            return E.G.env
        if e.envvar != null:
            local site is em_site of [E, e.line, em_envdesc of [E, e.envvar], ""]
            return "(lr_index of [" + (em_var_ref of (e.envvar)) + ", " + (em_strlit of (e.n)) + ", " + site + "])"
        local site is em_site of [E, e.line, "global '" + e.n + "'", ""]
        if E.G.env != "lr_G":
            return "(lr_index of [ENV[0], " + (em_strlit of (e.n)) + ", " + site + "])"
        return "(lr_gget of [" + (em_strlit of (e.n)) + ", " + site + "])"
    if k == "Paren":
        return em_expr of [E, e.e]
    if k == "Index":
        local site is em_site of [E, e.line, em_desc of [E, e.o], em_desc of [E, e]]
        local cs is em_operands of [E, [e.o, e.key]]
        return "(lr_index of [" + cs[0] + ", " + cs[1] + ", " + site + "])"
    if k == "Call" or k == "MCall":
        return em_call of [E, e, 0]
    if k == "Func":
        return em_closure of [E, e]
    if k == "Table":
        return em_table of [E, e]
    if k == "Un":
        local site is em_site of [E, e.line, em_desc of [E, e.a], ""]
        local a is em_expr of [E, e.a]
        if e.op == "not":
            return "(lr_not of (" + a + "))"
        if e.op == "-":
            return "(lr_unm of [" + a + ", " + site + "])"
        if e.op == "#":
            return "(lr_len of [" + a + ", " + site + "])"
        return "(lr_bnot of [" + a + ", " + site + "])"
    if k == "Bin":
        if e.op == "and" or e.op == "or":
            return em_andor of [E, e]
        local site is em_site of [E, e.line, em_desc of [E, e.a], em_desc of [E, e.b]]
        local cs is em_operands of [E, [e.a, e.b]]
        return "(" + (em_binop_fn of (e.op)) + " of [" + cs[0] + ", " + cs[1] + ", " + site + "])"
    throw of (["INTERNAL", "unknown expression " + k])

# Truth test of e as EigenScript code that is a bool.
define em_cond(E, e) as:
    if e.k == "Bin" and (e.op == "==" or e.op == "~=" or e.op == "<" or e.op == "<=" or e.op == ">" or e.op == ">="):
        return em_expr of [E, e]
    if e.k == "Un" and e.op == "not":
        return em_expr of [E, e]
    if e.k == "True":
        return "true"
    if e.k == "False" or e.k == "Nil":
        return "false"
    return "(lr_t of (" + (em_expr of [E, e]) + "))"

define em_andor(E, e) as:
    local a is em_expr of [E, e.a]
    if em_pure of (e.b):
        local b0 is em_expr of [E, e.b]
        if e.op == "and":
            return "(lr_and of [" + a + ", " + b0 + "])"
        return "(lr_or of [" + a + ", " + b0 + "])"
    local t is em_tmp of (E)
    em_line of [E, "local " + t + " is " + a]
    if e.op == "and":
        em_line of [E, "if lr_t of (" + t + "):"]
    else:
        em_line of [E, "if not (lr_t of (" + t + ")):"]
    em_indent of (E)
    local b is em_expr of [E, e.b]
    em_line of [E, t + " is " + b]
    em_dedent of (E)
    return t

define em_table(E, e) as:
    local site is em_site of [E, e.line, "", ""]
    local items is e.items
    local n is len of items
    if n == 0:
        return "(lr_tnew of [[], [], " + site + "])"
    # every field in source order; a trailing positional multi expands
    local exprs is []
    local kinds is []
    local i is 0
    for it in items:
        if it.t == "kv":
            append of [exprs, it.key]
            append of [kinds, "k"]
            append of [exprs, it.e]
            append of [kinds, "v"]
        else:
            append of [exprs, it.e]
            append of [kinds, "p"]
    local lastpos is items[n - 1].t == "pos" and em_is_multi of (items[n - 1].e)
    local codes is []
    local tail is ""
    if lastpos:
        local r is em_operands_multi of [E, list_slice of [exprs, 0, len of exprs - 1], exprs[len of exprs - 1]]
        codes is r[0]
        tail is r[1]
    else:
        codes is em_operands of [E, exprs]
    local pos is []
    local kv is []
    i is 0
    loop while i < len of codes:
        if kinds[i] == "p":
            append of [pos, codes[i]]
        else:
            append of [kv, codes[i]]
        i is i + 1
    local pl is em_listlit of (pos)
    if lastpos:
        pl is "(concat of [" + pl + ", " + tail + "])"
    return "(lr_tnew of [" + pl + ", " + (em_listlit of (kv)) + ", " + site + "])"

define em_closure(E, fn) as:
    em_function of [E.G, fn]
    local cells is []
    local names is []
    for v in fn.free:
        append of [cells, "c" + (str of v.id)]
        append of [names, em_strlit of (v.name)]
    local cl is "(F" + (str of fn.id) + " of ([" + (join of [cells, ", "]) + "]))"
    return cl

# Emit the factory for fn into G.funcs.
define em_function(G, fn) as:
    local E is {"G": G, "out": [], "ind": "", "fn": fn, "loops": [], "tbc": []}
    local id is str of fn.id
    em_line of [E, "define F" + id + "(U) as:"]
    em_indent of (E)
    local i is 0
    for v in fn.free:
        em_line of [E, "local c" + (str of v.id) + " is U[" + (str of i) + "]"]
        i is i + 1
    em_line of [E, "define f" + id + "(A) as:"]
    em_indent of (E)
    # debug.getupvalue asks a Lua function for its upvalue cells and their
    # names by calling it with null for its argument list (lr_upvals); a
    # call always passes a list. Comparing with null is the cheapest test
    # measured (EigenLua#9: 1.6% of a Lua call, against 6.1% for a type
    # test). A loaded chunk's main function has the one upvalue _ENV, the
    # cell ENV
    # [cells, names, definition site, is main, last line]
    local dsite is em_site of [E, fn.line, "", ""]
    local tail is ", " + dsite + ", " + (str of (fn.main == 1)) + ", " + (str of fn.endline) + "]"
    em_line of [E, "if A == null:"]
    if fn.main == 1 and G.env != "lr_G":
        em_line of [E, "    return [[ENV], [\"_ENV\"]" + tail]
    else:
        local names is []
        for v in fn.free:
            append of [names, em_strlit of (v.name)]
        em_line of [E, "    return [U, [" + (join of [names, ", "]) + "]" + tail]
    local np is len of fn.pvars
    i is 0
    for v in fn.pvars:
        local val is "lr_at of [A, " + (str of i) + "]"
        if v.cap:
            em_line of [E, "local c" + (str of v.id) + " is " + (em_cell of [E, val])]
        else:
            em_line of [E, "local v" + (str of v.id) + " is " + val]
        i is i + 1
    if fn.vararg:
        em_line of [E, "local V is list_slice of [A, " + (str of np) + ", len of A]"]
    if fn.hasgoto:
        em_line of [E, "local gj is 0"]
    if fn.envvar != null:
        em_declare of [E, fn.envvar, G.env]
    em_block of [E, fn.body, fn.bend]
    em_line of [E, "return []"]
    em_dedent of (E)
    em_line of [E, "return f" + id]
    append of [G.funcs, join of [E.out, "\n"]]

# bend: the line where the block's to-be-closed variables close when it
# ends normally (lparser.c lastline at leaveblock; a function's final return)
define em_block(E, stats, bend) as:
    em_block_tail of [E, stats, null, bend]

# A block whose last act, inside every to-be-closed region it opens, is to
# set tail.v to the truth of tail.cond (when tail is not null): a
# repeat-until condition sees the body's locals and runs before they are
# closed.
define em_block_tail(E, stats, tail, bend) as:
    local pb is E.bend
    E.bend is bend
    em_block_tail1 of [E, stats, tail]
    E.bend is pb

define em_block_tail1(E, stats, tail) as:
    local haslabel is false
    for s in stats:
        if s.k == "Label":
            haslabel is true
    if not haslabel:
        em_stats of [E, stats, 0, tail]
        return null
    local p is -1
    local i is 0
    loop while i < len of stats and p < 0:
        if stats[i].k == "Local" and list_contains of [stats[i].attribs, "close"]:
            p is i
        i is i + 1
    if p < 0:
        em_block_labels of [E, stats]
        if tail != null:
            em_line of [E, tail.v + " is " + (em_cond of [E, tail.cond])]
        return null
    # A to-be-closed local in a block with labels: the rest of the block
    # after it is one region (a nested block, with its own labels), closed
    # on normal exit, on a goto or break that leaves it, and on an error.
    # Labels at the end of the block (only void statements follow, so no
    # local is in scope there) stay outside the region: a goto to one
    # leaves the region. A repeat-until body has none (its condition sees
    # the locals).
    local q is len of stats
    if tail == null:
        loop while q > p + 1 and stats[q - 1].k == "Label":
            q is q - 1
    local st2 is list_slice of [stats, 0, p + 1]
    append of [st2, {"k": "TbcRest", "s": stats[p], "rest": list_slice of [stats, p + 1, q], "tail": tail, "line": stats[p].line}]
    for s in list_slice of [stats, q, len of stats]:
        append of [st2, s]
    em_block_labels of [E, st2]

# Statements from index i; a to-be-closed local wraps the rest of its block.
define em_stats(E, stats, i, tail) as:
    loop while i < len of stats:
        local s is stats[i]
        em_stat of [E, s]
        if s.k == "Local" and list_contains of [s.attribs, "close"]:
            em_tbc_region of [E, s, stats, i + 1, tail]
            return null
        i is i + 1
    if tail != null:
        em_line of [E, tail.v + " is " + (em_cond of [E, tail.cond])]

# local x <close> = v: the rest of the block runs in a try; x is closed
# (its __close called) on normal exit, before a return, break or goto that
# leaves it, and with the error value when an error unwinds it.
define em_tbc_region(E, s, stats, from, tail) as:
    local k is list_index_of of [s.attribs, "close"]
    local v is s.vars[k]
    local tb is em_tmp of (E)
    local site is em_site of [E, s.line, "", ""]
    em_line of [E, "local " + tb + " is [" + (em_var_ref of (v)) + ", false]"]
    em_line of [E, "lr_tbc_check of [" + tb + "[0], " + (em_strlit of (v.name)) + ", " + site + "]"]
    em_line of [E, "try:"]
    em_indent of (E)
    append of [E.tbc, {"t": tb, "ld": len of E.loops, "site": site}]
    em_stats of [E, stats, from, tail]
    list_truncate of [E.tbc, len of E.tbc - 1]
    em_line of [E, "lr_tbc_close of [" + tb + ", null, " + (em_site of [E, E.bend, "", ""]) + "]"]
    em_dedent of (E)
    em_line of [E, "catch " + tb + "e:"]
    em_line of [E, "    lr_tbc_unwind of [" + tb + ", " + tb + "e, " + site + "]"]

# The region of a to-be-closed local s in a block with labels: rest is the
# rest of its block, emitted as a block of its own.
define em_tbc_rest(E, r) as:
    local s is r.s
    local k is list_index_of of [s.attribs, "close"]
    local v is s.vars[k]
    local tb is em_tmp of (E)
    local site is em_site of [E, s.line, "", ""]
    em_line of [E, "local " + tb + " is [" + (em_var_ref of (v)) + ", false]"]
    em_line of [E, "lr_tbc_check of [" + tb + "[0], " + (em_strlit of (v.name)) + ", " + site + "]"]
    em_line of [E, "try:"]
    em_indent of (E)
    append of [E.tbc, {"t": tb, "ld": len of E.loops, "site": site}]
    em_block_tail of [E, r.rest, r.tail, E.bend]
    list_truncate of [E.tbc, len of E.tbc - 1]
    em_line of [E, "lr_tbc_close of [" + tb + ", null, " + (em_site of [E, E.bend, "", ""]) + "]"]
    em_dedent of (E)
    em_line of [E, "catch " + tb + "e:"]
    em_line of [E, "    lr_tbc_unwind of [" + tb + ", " + tb + "e, " + site + "]"]

# Close the to-be-closed variables declared inside E.loops[depth:] (all of
# them for depth 0), innermost first, at Lua line `line`.
define em_close_tbc(E, depth, line) as:
    local i is len of E.tbc - 1
    loop while i >= 0:
        local t is E.tbc[i]
        if t.ld >= depth:
            em_line of [E, "lr_tbc_close of [" + t.t + ", null, " + (em_site of [E, line, "", ""]) + "]"]
        i is i - 1

# Declare a local v with value code.
define em_declare(E, v, code) as:
    if v.cap:
        em_line of [E, "local c" + (str of v.id) + " is " + (em_cell of [E, code])]
    else:
        em_line of [E, "local v" + (str of v.id) + " is " + code]

# Adjust an expression list to exactly n single values (codes), evaluating
# every expression once, in order.
define em_adjust(E, exprs, n) as:
    local m is len of exprs
    local out is []
    if m == 0:
        for i in range of n:
            append of [out, "null"]
        return out
    local last is exprs[m - 1]
    if m < n and em_is_multi of (last):
        local r is em_operands_multi of [E, list_slice of [exprs, 0, m - 1], last]
        local codes is r[0]
        local lt is em_tmp of (E)
        em_line of [E, "local " + lt + " is " + r[1]]
        for c in codes:
            append of [out, c]
        local j is 0
        loop while len of out < n:
            append of [out, "(lr_at of [" + lt + ", " + (str of j) + "])"]
            j is j + 1
        return out
    local codes is em_operands of [E, exprs]
    if m > n:
        # surplus expressions are evaluated for their effects, after the kept
        # ones: pin the kept values first so the order stays left to right
        local kept is em_pin of [E, list_slice of [codes, 0, n]]
        for c in kept:
            append of [out, c]
        local i is n
        loop while i < m:
            em_line of [E, codes[i]]
            i is i + 1
        return out
    for c in codes:
        append of [out, c]
    loop while len of out < n:
        append of [out, "null"]
    return out

# Pin every non-temp code into a temp so later statements cannot change it.
define em_pin(E, codes) as:
    local out is []
    for c in codes:
        if em_is_tmp of (c) or c == "null" or c == "true" or c == "false":
            append of [out, c]
        else:
            local t is em_tmp of (E)
            em_line of [E, "local " + t + " is " + c]
            append of [out, t]
    return out

define em_assign_to(E, target, code, site_line) as:
    if target.k == "Name":
        if target.var != null:
            em_line of [E, (em_var_ref of (target.var)) + " is " + code]
        else:
            local site is em_site of [E, site_line, "", ""]
            if target.envvar != null:
                site is em_site of [E, site_line, em_envdesc of [E, target.envvar], ""]
                em_line of [E, "lr_setindex of [" + (em_var_ref of (target.envvar)) + ", " + (em_strlit of (target.n)) + ", " + code + ", " + site + "]"]
            elif E.G.env != "lr_G":
                em_line of [E, "lr_setindex of [ENV[0], " + (em_strlit of (target.n)) + ", " + code + ", " + site + "]"]
            else:
                em_line of [E, "lr_gset of [" + (em_strlit of (target.n)) + ", " + code + ", " + site + "]"]
        return null
    throw of (["INTERNAL", "assign target"])

define em_stat(E, s) as:
    local k is s.k
    if k == "Local":
        local vals is em_adjust of [E, s.exprs, len of s.vars]
        if len of s.vars > 1:
            vals is em_pin of [E, vals]
        local i is 0
        for v in s.vars:
            em_declare of [E, v, vals[i]]
            i is i + 1
    elif k == "LocalFunction":
        local v is s.var
        if v.cap:
            em_line of [E, "local c" + (str of v.id) + " is " + (em_cell of [E, "null"])]
            local fc is em_closure of [E, s.func]
            em_line of [E, "c" + (str of v.id) + "[0] is " + fc]
        else:
            local fc is em_closure of [E, s.func]
            em_line of [E, "local v" + (str of v.id) + " is " + fc]
    elif k == "Assign":
        em_assign of [E, s]
    elif k == "CallStat":
        em_call of [E, s.e, 1]
    elif k == "Do":
        em_block of [E, s.body, s.bend]
    elif k == "While":
        local mark is len of E.out
        local c is em_cond of [E, s.cond]
        if len of E.out == mark:
            em_line of [E, "loop while " + c + ":"]
            em_indent of (E)
        else:
            # the condition hoisted statements: they re-run each iteration
            local hoisted is list_slice of [E.out, mark, len of E.out]
            list_truncate of [E.out, mark]
            em_line of [E, "loop while 1:"]
            for h in hoisted:
                append of [E.out, "    " + h]
            em_indent of (E)
            em_line of [E, "if not (" + c + "):"]
            em_line of [E, "    break"]
        local LW is em_loop_begin of [E, "lua"]
        LW.endl is s.endl
        em_block of [E, s.body, s.bend]
        em_line of [E, "null"]
        em_dedent of (E)
        em_loop_end of (E)
    elif k == "Repeat":
        em_line of [E, "loop while 1:"]
        em_indent of (E)
        local LR is em_loop_begin of [E, "lua"]
        LR.endl is s.endl
        local rc is em_tmp of (E)
        em_line of [E, "local " + rc + " is false"]
        em_block_tail of [E, s.body, {"cond": s.cond, "v": rc}, s.bend]
        em_line of [E, "if " + rc + ":"]
        em_line of [E, "    break"]
        em_dedent of (E)
        em_loop_end of (E)
    elif k == "If":
        em_if of [E, s, 0]
    elif k == "NumFor":
        em_numfor of [E, s]
    elif k == "GenFor":
        em_genfor of [E, s]
    elif k == "Return":
        local n is len of s.exprs
        local rc is ""
        if n == 1 and em_is_multi of (s.exprs[0]):
            rc is em_multi of [E, s.exprs[0]]
        else:
            rc is em_explist of [E, s.exprs]
        if len of E.tbc > 0:
            # the values first, then the to-be-closed variables, innermost first
            local rt is em_tmp of (E)
            em_line of [E, "local " + rt + " is " + rc]
            em_close_tbc of [E, 0, s.lastline]
            rc is rt
        em_line of [E, "return " + rc]
    elif k == "Break":
        em_break of (E)
    elif k == "Goto":
        em_goto of [E, s]
    elif k == "Label":
        null
    elif k == "TbcRest":
        em_tbc_rest of [E, s]
    else:
        em_unsup of [k, s.line]

define em_if(E, s, i) as:
    local c is em_cond of [E, s.conds[i]]
    em_line of [E, "if " + c + ":"]
    em_indent of (E)
    em_block of [E, s.blocks[i], s.bends[i]]
    em_line of [E, "null"]
    em_dedent of (E)
    # elseif becomes elif (EigenScript caps nesting at 64 levels); a condition
    # that hoists statements needs them inside an else, so it nests instead
    local k is i + 1
    loop while k < len of s.conds:
        local mark is len of E.out
        local c2 is em_cond of [E, s.conds[k]]
        if len of E.out != mark:
            local hoisted is list_slice of [E.out, mark, len of E.out]
            list_truncate of [E.out, mark]
            em_line of [E, "else:"]
            for h in hoisted:
                append of [E.out, "    " + h]
            em_indent of (E)
            em_line of [E, "if " + c2 + ":"]
            em_indent of (E)
            em_block of [E, s.blocks[k], s.bends[k]]
            em_line of [E, "null"]
            em_dedent of (E)
            em_if_rest of [E, s, k + 1]
            em_dedent of (E)
            return null
        em_line of [E, "elif " + c2 + ":"]
        em_indent of (E)
        em_block of [E, s.blocks[k], s.bends[k]]
        em_line of [E, "null"]
        em_dedent of (E)
        k is k + 1
    em_if_else of [E, s]

# The rest of an if chain from condition k, after an if block.
define em_if_rest(E, s, k) as:
    if k < len of s.conds:
        em_line of [E, "else:"]
        em_indent of (E)
        em_if of [E, s, k]
        em_dedent of (E)
    else:
        em_if_else of [E, s]

define em_if_else(E, s) as:
    if s["else"] != null:
        em_line of [E, "else:"]
        em_indent of (E)
        em_block of [E, s["else"], s.bends[len of s.bends - 1]]
        em_line of [E, "null"]
        em_dedent of (E)

define em_assign(E, s) as:
    local targets is s.targets
    local nt is len of targets
    if nt == 1 and len of s.exprs == 1:
        local tg is targets[0]
        if tg.k == "Name":
            local c is em_expr of [E, s.exprs[0]]
            em_assign_to of [E, tg, c, s.line]
            return null
        local site is em_site of [E, tg.line, em_desc of [E, tg.o], ""]
        local cs is em_operands of [E, [tg.o, tg.key, s.exprs[0]]]
        em_line of [E, "lr_setindex of [" + cs[0] + ", " + cs[1] + ", " + cs[2] + ", " + site + "]"]
        return null
    # general case: evaluate target prefixes and keys, then all values, then
    # assign right to left (as PUC-Rio does)
    local tcodes is []
    for tg in targets:
        if tg.k == "Index":
            local cs is em_operands of [E, [tg.o, tg.key]]
            append of [tcodes, em_pin of [E, cs]]
        else:
            append of [tcodes, null]
    local vals is em_pin of [E, em_adjust of [E, s.exprs, nt]]
    local i is nt - 1
    loop while i >= 0:
        local tg is targets[i]
        if tg.k == "Name":
            em_assign_to of [E, tg, vals[i], s.line]
        else:
            local site is em_site of [E, tg.line, em_desc of [E, tg.o], ""]
            em_line of [E, "lr_setindex of [" + tcodes[i][0] + ", " + tcodes[i][1] + ", " + vals[i] + ", " + site + "]"]
        i is i - 1
    return null

define em_numfor(E, s) as:
    local site is em_site of [E, s.line, "", ""]
    local c3 is "1"
    local cs is []
    if s.c != null:
        cs is em_operands of [E, [s.a, s.b, s.c]]
        c3 is cs[2]
    else:
        cs is em_operands of [E, [s.a, s.b]]
    local tp is em_tmp of (E)
    em_line of [E, "local " + tp + " is lr_forprep of [" + cs[0] + ", " + cs[1] + ", " + c3 + ", " + site + "]"]
    local ti is em_tmp of (E)
    local ts is em_tmp of (E)
    local tl is em_tmp of (E)
    local st is em_tmp of (E)
    em_line of [E, "local " + ti + " is " + tp + "[0]"]
    em_line of [E, "local " + tl + " is " + tp + "[1]"]
    em_line of [E, "local " + st + " is " + tp + "[2]"]
    em_line of [E, "local " + ts + " is " + tp + "[3]"]
    local tc is em_tmp of (E)
    em_line of [E, "local " + tc + " is " + tp + "[4]"]
    # an integer loop counts down tc; a float loop (tc < 0) compares
    em_line of [E, "loop while " + tc + " > 0 or (" + tc + " < 0 and " + ti + " * " + ts + " <= " + tl + "):"]
    em_indent of (E)
    local LN is em_loop_begin of [E, "lua"]
    LN.endl is s.endl
    em_declare of [E, s.v, ti]
    em_line of [E, ti + " is " + ti + " + " + st]
    em_line of [E, tc + " is " + tc + " - 1"]
    em_block of [E, s.body, s.bend]
    em_line of [E, "null"]
    em_dedent of (E)
    em_loop_end of (E)

# The explist is adjusted to four values (manual 3.3.5); the fourth is a
# to-be-closed variable, closed when the loop ends however it ends. When it
# is nil by construction no region is opened.
define em_genfor(E, s) as:
    local site is em_site of [E, s.eline, "for iterator 'for iterator'", ""]
    local vals is em_pin of [E, em_adjust of [E, s.exprs, 4]]
    local tf is vals[0]
    local tst is vals[1]
    local tc is em_tmp of (E)
    em_line of [E, "local " + tc + " is " + vals[2]]
    if vals[3] == "null":
        em_genfor_loop of [E, s, site, tf, tst, tc]
        return null
    local tb is em_tmp of (E)
    local csite is em_site of [E, s.line, "", ""]
    em_line of [E, "local " + tb + " is [" + vals[3] + ", false]"]
    em_line of [E, "lr_tbc_check of [" + tb + "[0], \"(for state)\", " + csite + "]"]
    em_line of [E, "try:"]
    em_indent of (E)
    append of [E.tbc, {"t": tb, "ld": len of E.loops, "site": csite}]
    em_genfor_loop of [E, s, site, tf, tst, tc]
    list_truncate of [E.tbc, len of E.tbc - 1]
    # normal exit and break close at the loop's end (lparser.c forbody's
    # leaveblock runs at its 'end' line)
    em_line of [E, "lr_tbc_close of [" + tb + ", null, " + (em_site of [E, s.endl, "", ""]) + "]"]
    em_dedent of (E)
    em_line of [E, "catch " + tb + "e:"]
    em_line of [E, "    lr_tbc_unwind of [" + tb + ", " + tb + "e, " + csite + "]"]

define em_genfor_loop(E, s, site, tf, tst, tc) as:
    em_line of [E, "loop while 1:"]
    em_indent of (E)
    local LG is em_loop_begin of [E, "lua"]
    LG.endl is s.endl
    local tr is em_tmp of (E)
    em_line of [E, "local " + tr + " is lr_ccall of [" + tf + ", [" + tst + ", " + tc + "], " + site + "]"]
    local i is 0
    local t0 is em_tmp of (E)
    em_line of [E, "local " + t0 + " is lr_at of [" + tr + ", 0]"]
    em_line of [E, "if " + t0 + " == null:"]
    em_line of [E, "    break"]
    em_line of [E, tc + " is " + t0]
    for v in s.vars:
        if i == 0:
            em_declare of [E, v, t0]
        else:
            em_declare of [E, v, "lr_at of [" + tr + ", " + (str of i) + "]"]
        i is i + 1
    em_block of [E, s.body, s.bend]
    em_line of [E, "null"]
    em_dedent of (E)
    em_loop_end of (E)

em_rt_parts is ["rt_pattern.eigs", "rt_format.eigs", "rt_math.eigs", "rt_utf8.eigs", "rt_coroutine.eigs", "rt_io.eigs", "rt_pack.eigs"]

define em_dirname(p) as:
    local i is len of p - 1
    loop while i >= 0 and p[i] != "/":
        i is i - 1
    if i < 0:
        return "."
    if i == 0:
        return "/"
    return p[0:i]

define emit_program(ast, file, runtime) as:
    local G is {"funcs": [], "sites": [[-1, "", ""]], "sitebase": 0, "chunk": false, "labelloop": {}, "labseen": {}, "labline": {}, "env": "lr_G", "fid": -1, "vid": 0, "tmp": 0, "file": file}
    local R is {"G": G, "scopes": [], "fn": null}
    rs_func of [R, ast, null]
    em_function of [G, ast]
    local out is []
    # the runtime library parts, then runtime.eigs, which builds the tables
    for part in em_rt_parts:
        append of [out, "load_file of " + (em_strlit of ((em_dirname of (runtime)) + "/" + part))]
    append of [out, "load_file of " + (em_strlit of (runtime))]
    append of [out, "lr_st.srcdir is " + (em_strlit of (em_dirname of (runtime)))]
    append of [out, "S is []"]
    for st in G.sites:
        append of [out, "append of [S, [" + (str of st[0]) + ", " + (em_strlit of (st[1])) + ", " + (em_strlit of (st[2])) + "]]"]
    for f in G.funcs:
        append of [out, f]
    append of [out, "unobserved:"]
    append of [out, "    lr_main of [F" + (str of ast.id) + " of ([]), " + (em_strlit of (file)) + ", S]"]
    return (join of [out, "\n"]) + "\n"

# A chunk compiled at run time by load: the code of a function L(ENV) whose
# result is the chunk's main function, its globals indexing ENV[0] (ENV is
# the cell of its _ENV upvalue, so debug.setupvalue can replace it). Sites
# are records in the chunk's own list S, made when L(ENV, SRC) runs (SRC:
# [chunkid, source]), so they are freed with the chunk (EigenLua#29); a site
# argument is S[k]. S is built by appends (a list literal holds at most 1024
# elements, gaps/list-literal-cap.eigs).
define emit_chunk(ast) as:
    local G is {"funcs": [], "sites": [], "sitebase": 0, "chunk": true, "labelloop": {}, "labseen": {}, "labline": {}, "env": "ENV[0]", "fid": -1, "vid": 0, "tmp": 0, "file": ""}
    local R is {"G": G, "scopes": [], "fn": null}
    rs_func of [R, ast, null]
    em_function of [G, ast]
    local out is ["define L(ENV, SRC) as:", "    local S is []"]
    for st in G.sites:
        append of [out, "    append of [S, [" + (str of st[0]) + ", " + (em_strlit of (st[1])) + ", " + (em_strlit of (st[2])) + ", SRC[0], SRC[1]]]"]
    for f in G.funcs:
        for ln in split of [f, "\n"]:
            append of [out, "    " + ln]
    append of [out, "    return F" + (str of ast.id) + " of ([])"]
    append of [out, "L"]
    return (join of [out, "\n"]) + "\n"

# ---------------------------------------------------------------- goto
# A block with labels becomes a dispatch loop over its segments (the
# statements before the first label, then from each label to the next):
#     local pcN is 0
#     loop while true:
#         if pcN <= 0: <segment 0>
#         if pcN <= 1: <segment 1>  ...
#         break
# A goto to a label of the innermost loop sets pcN and continues. A jump
# that must leave inner EigenScript loops first (a goto across a Lua loop,
# or a Lua break whose loop is outside a dispatch loop) stores its target in
# the function's gj and breaks; after every loop of such a function, gj is
# checked and the jump is taken or passed outward. E.loops is the stack of
# EigenScript loops being emitted.

define em_loop_begin(E, kind) as:
    E.G.tmp is E.G.tmp + 1
    local L is {"k": kind, "id": E.G.tmp, "labels": {}, "pc": ""}
    append of [E.loops, L]
    return L

define em_loop_end(E) as:
    list_truncate of [E.loops, len of E.loops - 1]
    if not E.fn.hasgoto or len of E.loops == 0:
        return null
    local O is E.loops[len of E.loops - 1]
    em_line of [E, "if gj != 0:"]
    em_indent of (E)
    if O.k == "disp":
        for key in keys of O.labels:
            em_line of [E, "if gj == " + key + ":"]
            em_line of [E, "    gj is 0"]
            em_line of [E, "    " + O.pc + " is " + (str of O.labels[key])]
            em_line of [E, "    continue"]
    else:
        em_line of [E, "if gj == " + (str of (0 - O.id)) + ":"]
        em_line of [E, "    gj is 0"]
        em_line of [E, "    break"]
    em_line of [E, "break"]
    em_dedent of (E)

define em_break(E) as:
    local top is E.loops[len of E.loops - 1]
    local i is len of E.loops - 1
    loop while E.loops[i].k != "lua":
        i is i - 1
    em_close_tbc of [E, i + 1, E.loops[i].endl]
    if top.k == "lua":
        em_line of [E, "break"]
        return null
    em_line of [E, "gj is " + (str of (0 - E.loops[i].id))]
    em_line of [E, "break"]

define em_goto(E, s) as:
    local D is E.G.labelloop[str of s.target]
    local top is E.loops[len of E.loops - 1]
    local di is 0
    loop while E.loops[di].id != D.id:
        di is di + 1
    # a backward goto closes at the goto, a forward one at its label
    local cl is s.line
    if not (has_key of [E.G.labseen, str of s.target]):
        cl is E.G.labline[str of s.target]
    em_close_tbc of [E, di + 1, cl]
    if top.id == D.id:
        em_line of [E, D.pc + " is " + (str of D.labels[str of s.target])]
        em_line of [E, "continue"]
        return null
    em_line of [E, "gj is " + (str of s.target)]
    em_line of [E, "break"]

define em_block_labels(E, stats) as:
    local pc is em_tmp of (E)
    em_line of [E, "local " + pc + " is 0"]
    em_line of [E, "loop while true:"]
    em_indent of (E)
    local D is em_loop_begin of [E, "disp"]
    D.pc is pc
    local seg is 0
    for s in stats:
        if s.k == "Label":
            seg is seg + 1
            D.labels[str of s.id] is seg
            E.G.labline[str of s.id] is s.line
            E.G.labelloop[str of s.id] is D
    seg is 0
    em_line of [E, "if " + pc + " <= 0:"]
    em_indent of (E)
    for s in stats:
        if s.k == "Label":
            em_line of [E, "null"]
            E.G.labseen[str of s.id] is true
            em_dedent of (E)
            seg is seg + 1
            em_line of [E, "if " + pc + " <= " + (str of seg) + ":"]
            em_indent of (E)
        else:
            em_stat of [E, s]
    em_line of [E, "null"]
    em_dedent of (E)
    em_line of [E, "break"]
    em_dedent of (E)
    em_loop_end of (E)
