# EigenLua runtime: string.pack, string.unpack and string.packsize, a port of
# lstrlib.c (5.4.9) for a 64-bit little-endian host (int 4, long 8, size_t 8,
# lua_Integer 8, native alignment 8).
#
# Packing builds a byte list and makes the string with str_from_bytes, the
# direct translation: a result holding a zero byte ends there
# (gaps/nul-in-string.eigs). 64-bit values go through their two's
# complement halves (lr_u64), and an unpacked integer past 2^53 is rounded
# to a double (gaps/no-int64.eigs).

define lr_pk_err(msg) as:
    lr_throw of ((lr_where of (1)) + msg)

define lr_pk_digit(fmt, i) as:
    if i >= len of fmt:
        return false
    local o is ord of fmt[i]
    return o >= 48 and o <= 57

# getnum: [value, next index]
define lr_pk_getnum(fmt, i, df) as:
    if not (lr_pk_digit of [fmt, i]):
        return [df, i]
    local a is 0
    loop while 1:
        a is a * 10 + (ord of fmt[i]) - 48
        i is i + 1
        if not (lr_pk_digit of [fmt, i]) or a > 214748363:
            break
    return [a, i]

define lr_pk_getnumlimit(fmt, i, df) as:
    local r is lr_pk_getnum of [fmt, i, df]
    if r[0] > 16 or r[0] <= 0:
        lr_pk_err of ("integral size (" + (str of r[0]) + ") out of limits [1,16]")
    return r

# getoption: [kind, size, next index]; h holds islittle and maxalign.
define lr_pk_option(h, fmt, i) as:
    local opt is fmt[i]
    i is i + 1
    if opt == "b":
        return ["int", 1, i]
    if opt == "B":
        return ["uint", 1, i]
    if opt == "h":
        return ["int", 2, i]
    if opt == "H":
        return ["uint", 2, i]
    if opt == "l" or opt == "j":
        return ["int", 8, i]
    if opt == "L" or opt == "J" or opt == "T":
        return ["uint", 8, i]
    if opt == "f":
        return ["float", 4, i]
    if opt == "n" or opt == "d":
        return ["double", 8, i]
    if opt == "i" or opt == "I" or opt == "s":
        local df is 4
        if opt == "s":
            df is 8
        local r is lr_pk_getnumlimit of [fmt, i, df]
        local kind is "int"
        if opt == "I":
            kind is "uint"
        elif opt == "s":
            kind is "string"
        return [kind, r[0], r[1]]
    if opt == "c":
        local r2 is lr_pk_getnum of [fmt, i, -1]
        if r2[0] == -1:
            lr_pk_err of ("missing size for format option 'c'")
        return ["char", r2[0], r2[1]]
    if opt == "z":
        return ["zstr", 0, i]
    if opt == "x":
        return ["padding", 1, i]
    if opt == "X":
        return ["paddalign", 0, i]
    if opt == " ":
        return ["nop", 0, i]
    if opt == "<" or opt == "=":
        h.little is true
        return ["nop", 0, i]
    if opt == ">":
        h.little is false
        return ["nop", 0, i]
    if opt == "!":
        local r3 is lr_pk_getnumlimit of [fmt, i, 8]
        h.maxalign is r3[0]
        return ["nop", 0, r3[1]]
    lr_pk_err of ("invalid format option '" + opt + "'")

# getdetails: [kind, size, ntoalign, next index]
define lr_pk_details(h, total, fmt, i, fname) as:
    local o is lr_pk_option of [h, fmt, i]
    local kind is o[0]
    local size is o[1]
    i is o[2]
    local align is size
    if kind == "paddalign":
        if i >= len of fmt:
            lr_argerr of [1, fname, "invalid next option for option 'X'"]
        local o2 is lr_pk_option of [h, fmt, i]
        align is o2[1]
        i is o2[2]
        if o2[0] == "char" or align == 0:
            lr_argerr of [1, fname, "invalid next option for option 'X'"]
    local ntoalign is 0
    if align > 1 and kind != "char":
        if align > h.maxalign:
            align is h.maxalign
        if bit_and of [align, align - 1] != 0:
            lr_argerr of [1, fname, "format asks for alignment not power of 2"]
        ntoalign is bit_and of [align - (bit_and of [total, align - 1]), align - 1]
    return [kind, size, ntoalign, i]

# The size bytes of integral n (two's complement), in the header's order.
define lr_pk_intbytes(n, size, little) as:
    local w is lr_u64 of (n)
    local hi is w[0]
    local lo is w[1]
    local le is []
    for k in range of size:
        if k < 4:
            append of [le, bit_and of [floor of (lo / (pow of [2, 8 * k])), 255]]
        elif k < 8:
            append of [le, bit_and of [floor of (hi / (pow of [2, 8 * (k - 4)])), 255]]
        elif n < 0:
            append of [le, 255]
        else:
            append of [le, 0]
    if little:
        return le
    local be is []
    local j is size - 1
    loop while j >= 0:
        append of [be, le[j]]
        j is j - 1
    return be

# The IEEE single-precision bits of x, rounded to nearest even.
define lr_pk_f32bits(x) as:
    local sign is 0
    if x < 0 or (x == 0 and (f64_to_bytes of x)[0] >= 128):
        sign is 2147483648
    local ax is abs of x
    if ax == 0:
        return sign
    local me is lr_fx_decompose of (ax)
    local m is me[0]
    local e2 is me[1]
    # normalise m to 53 bits: value = m * 2^e2, 2^52 <= m < 2^53
    loop while m < 4503599627370496:
        m is m * 2
        e2 is e2 - 1
    local ex is e2 + 52
    # single precision: 24-bit significand, exponent bias 127
    local shift is 29
    if ex < -126:
        shift is 29 + (-126 - ex)
    if shift > 60:
        return sign
    local q is floor of (m / (pow of [2, shift]))
    local r is m - q * (pow of [2, shift])
    local half is pow of [2, shift - 1]
    if r > half or (r == half and q % 2 == 1):
        q is q + 1
    if ex < -126:
        # subnormal (q may round up into the smallest normal)
        return sign + q
    if q >= 16777216:
        q is q / 2
        ex is ex + 1
    if ex > 127:
        return sign + 2139095040
    return sign + (ex + 127) * 8388608 + (q - 8388608)

define lr_pk_f32value(bits) as:
    local sign is 1
    if bits >= 2147483648:
        sign is -1
        bits is bits - 2147483648
    local ex is floor of (bits / 8388608)
    local fr is bits - ex * 8388608
    if ex == 0:
        return sign * fr * (pow of [2, -149])
    # 255 is inf/nan: the direct translation computes the value it encodes
    return sign * (fr + 8388608) * (pow of [2, ex - 150])

define lr_pk_order(bytes, little) as:
    if little:
        local out is []
        local j is len of bytes - 1
        loop while j >= 0:
            append of [out, bytes[j]]
            j is j - 1
        return out
    return bytes

define lr_s_pack(A0) as:
    local fmt is lr_checkstr of [A0, 0, "pack"]
    # str_pack pushes a nil marker after its arguments, so the first missing
    # argument reads as nil
    local A is concat of [A0, [null]]
    local h is {"little": true, "maxalign": 1}
    local out is []
    local total is 0
    local arg is 0
    local i is 0
    loop while i < len of fmt:
        local d is lr_pk_details of [h, total, fmt, i, "pack"]
        local kind is d[0]
        local size is d[1]
        local nta is d[2]
        i is d[3]
        total is total + nta + size
        loop while nta > 0:
            append of [out, 0]
            nta is nta - 1
        arg is arg + 1
        if kind == "int":
            local n is lr_checkint of [A, arg, "pack"]
            if size < 8:
                local lim is pow of [2, size * 8 - 1]
                if not (0 - lim <= n and n < lim):
                    lr_argerr of [arg + 1, "pack", "integer overflow"]
            for b in lr_pk_intbytes of [n, size, h.little]:
                append of [out, b]
        elif kind == "uint":
            local n2 is lr_checkint of [A, arg, "pack"]
            if size < 8:
                if n2 < 0 or n2 >= pow of [2, size * 8]:
                    lr_argerr of [arg + 1, "pack", "unsigned overflow"]
            for b in lr_pk_intbytes of [n2, size, h.little]:
                append of [out, b]
        elif kind == "float":
            local fb is lr_pk_f32bits of (lr_checknum of [A, arg, "pack"])
            local be is [bit_and of [floor of (fb / 16777216), 255], bit_and of [floor of (fb / 65536), 255], bit_and of [floor of (fb / 256), 255], bit_and of [fb, 255]]
            for b in lr_pk_order of [be, h.little]:
                append of [out, b]
        elif kind == "double":
            local db is f64_to_bytes of (lr_checknum of [A, arg, "pack"])
            for b in lr_pk_order of [db, h.little]:
                append of [out, b]
        elif kind == "char":
            local s is lr_checkstr of [A, arg, "pack"]
            if len of s > size:
                lr_argerr of [arg + 1, "pack", "string longer than given size"]
            for b in lr_bytes of (s):
                append of [out, b]
            local k is len of s
            loop while k < size:
                append of [out, 0]
                k is k + 1
        elif kind == "string":
            local s2 is lr_checkstr of [A, arg, "pack"]
            if size < 8 and len of s2 >= pow of [2, size * 8]:
                lr_argerr of [arg + 1, "pack", "string length does not fit in given size"]
            for b in lr_pk_intbytes of [len of s2, size, h.little]:
                append of [out, b]
            for b in lr_bytes of (s2):
                append of [out, b]
            total is total + len of s2
        elif kind == "zstr":
            local s3 is lr_checkstr of [A, arg, "pack"]
            for b in lr_bytes of (s3):
                append of [out, b]
            append of [out, 0]
            total is total + len of s3 + 1
        else:
            if kind == "padding":
                append of [out, 0]
            arg is arg - 1
    # direct translation: a zero byte ends the EigenScript string
    return [str_from_bytes of (out)]

define lr_s_packsize(A) as:
    local fmt is lr_checkstr of [A, 0, "packsize"]
    local h is {"little": true, "maxalign": 1}
    local total is 0
    local i is 0
    loop while i < len of fmt:
        local d is lr_pk_details of [h, total, fmt, i, "packsize"]
        i is d[3]
        if d[0] == "string" or d[0] == "zstr":
            lr_argerr of [1, "packsize", "variable-length format"]
        local size is d[1] + d[2]
        if total > 2147483647 - size:
            lr_argerr of [1, "packsize", "format result too large"]
        total is total + size
    return [total]

# unpackint: bytes[pos:pos + size] as a lua_Integer (rounded to a double).
define lr_pk_unpackint(bytes, pos, size, little, signed) as:
    local limit is size
    if limit > 8:
        limit is 8
    local le is []
    for k in range of size:
        if little:
            append of [le, bytes[pos + k]]
        else:
            append of [le, bytes[pos + size - 1 - k]]
    local hi is 0
    local lo is 0
    local k2 is limit - 1
    loop while k2 >= 0:
        if k2 >= 4:
            hi is hi * 256 + le[k2]
        else:
            lo is lo * 256 + le[k2]
        k2 is k2 - 1
    local v is hi * 4294967296 + lo
    if size < 8:
        if signed and v >= pow of [2, size * 8 - 1]:
            if size > 4:
                # from the halves, so a small negative value stays exact
                # (v itself is rounded once it passes 2^53)
                return (hi - (pow of [2, (size - 4) * 8])) * 4294967296 + lo
            v is v - (pow of [2, size * 8])
        return v
    local neg is signed and hi >= 2147483648
    if size > 8:
        local mask is 0
        if neg:
            mask is 255
        local k3 is 8
        loop while k3 < size:
            if le[k3] != mask:
                lr_pk_err of ((str of size) + "-byte integer does not fit into Lua Integer")
            k3 is k3 + 1
    if neg or (not signed and hi >= 2147483648):
        # the 64-bit two's complement value read as a lua_Integer
        return (hi - 4294967296) * 4294967296 + lo
    return v

define lr_s_unpack(A) as:
    local fmt is lr_checkstr of [A, 0, "unpack"]
    local data is lr_checkstr of [A, 1, "unpack"]
    local ld is len of data
    local bytes is lr_bytes of (data)
    local pos is (lr_posrelat of [lr_optint of [A, 2, "unpack", 1], ld]) - 1
    if pos > ld or pos < 0:
        lr_argerr of [3, "unpack", "initial position out of string"]
    local h is {"little": true, "maxalign": 1}
    local out is []
    local i is 0
    loop while i < len of fmt:
        local d is lr_pk_details of [h, pos, fmt, i, "unpack"]
        local kind is d[0]
        local size is d[1]
        local nta is d[2]
        i is d[3]
        if nta + size > ld - pos:
            lr_argerr of [2, "unpack", "data string too short"]
        pos is pos + nta
        if kind == "int" or kind == "uint":
            append of [out, lr_pk_unpackint of [bytes, pos, size, h.little, kind == "int"]]
        elif kind == "float":
            local fb is lr_pk_order of [list_slice of [bytes, pos, pos + 4], h.little]
            append of [out, lr_pk_f32value of (((fb[0] * 256 + fb[1]) * 256 + fb[2]) * 256 + fb[3])]
        elif kind == "double":
            append of [out, f64_from_bytes of (lr_pk_order of [list_slice of [bytes, pos, pos + 8], h.little])]
        elif kind == "char":
            append of [out, data[pos:pos + size]]
        elif kind == "string":
            local n is lr_pk_unpackint of [bytes, pos, size, h.little, false]
            if n > ld - pos - size:
                lr_argerr of [2, "unpack", "data string too short"]
            append of [out, data[pos + size:pos + size + n]]
            pos is pos + n
        elif kind == "zstr":
            # the string holds no zero byte (it ends at the first), so the
            # terminator is the end of the data
            lr_argerr of [2, "unpack", "unfinished string for format 'z'"]
        pos is pos + size
    append of [out, pos + 1]
    return out
