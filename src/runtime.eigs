# EigenLua runtime library, loaded by every compiled program.
#
# Value mapping (owner decision, 2026-10-06: direct mapping, no shims):
#   nil -> null; true/false -> 1/0; number -> num (one IEEE double);
#   string -> str; function -> fn; table -> dict
#     {"id": n, "a": [...], "h": {...}, "o": {...}, "mt": table-or-null}
#   a: the array part, keys 1..len(a); holes are null, the last element is
#      never null, and key len(a)+1 is never in o, so len(a) is a border;
#   h: string keys; o: every other key, encoded -> [key, value].
# A Lua function takes one list of arguments and returns a list of results.
# Errors are thrown as {"LUAERR": 1, "v": value}. The call-site stack lr_stk holds
# the site id of every active call (0 = called from the runtime, "C"); the
# site table maps an id to [line, desc_a, desc_b] for positions and messages.

lr_st is {"asserts": 0, "chunk": "?", "sites": [[-1, "", ""]], "nid": 0, "srcdir": ".", "compiler": null, "curf": null}
lr_stk is []
lr_fnreg is []

# ------------------------------------------------------------ process edges

define lr_stderr(s) as:
    local b is []
    for i in range of (len of s):
        append of [b, ord of s[i]]
    write_bytes of ["/dev/stderr", b, 1]

define lr_exit(code) as:
    lr_stderr of ("EIGENLUA-ASSERTS:" + (str of lr_st.asserts) + "\n")
    exit of code

define lr_site_line(site) as:
    return lr_st.sites[site][0]

# The chunk name of a site: a site added by load carries its chunk's.
define lr_site_chunk(site) as:
    local sd is lr_st.sites[site]
    if len of sd > 3:
        return sd[3]
    return lr_st.chunk

# The construct is not handled: say so and exit 3, never run on.
define lr_unsup(what, site) as:
    local line is lr_site_line of (site)
    if line < 0:
        line is lr_cur_line of (1)
    lr_stderr of ("EIGENLUA-UNSUPPORTED: " + what + " at " + (lr_site_chunk of (site)) + ":" + (str of line) + "\n")
    lr_exit of 3

define lr_cur_line(level) as:
    local i is len of lr_stk - level
    if i < 0:
        return -1
    return lr_site_line of (lr_stk[i])

# "chunk:line: " for the function `level` frames up (luaL_where).
define lr_where(level) as:
    local line is lr_cur_line of (level)
    if line < 0:
        return ""
    return (lr_site_chunk of (lr_stk[len of lr_stk - level])) + ":" + (str of line) + ": "

define lr_throw(v) as:
    throw of ({"LUAERR": 1, "v": v})

define lr_rterr(site, msg) as:
    local line is lr_site_line of (site)
    if line < 0:
        throw of ({"LUAERR": 1, "v": (lr_where of (1)) + msg})
    throw of ({"LUAERR": 1, "v": (lr_site_chunk of (site)) + ":" + (str of line) + ": " + msg})

# luaL_argerror: the function is named as the call site names it (a
# method call does not count self), else by its global name (lauxlib.c
# pushglobalfuncname), else '?'.
define lr_argerr(n, fname, msg) as:
    local nm is "?"
    local site is 0
    if len of lr_stk > 0:
        site is lr_stk[len of lr_stk - 1]
    local sd is lr_st.sites[site]
    if site != 0 and len of sd[2] > 8 and sd[2][0:8] == "method '":
        nm is sd[2][8:len of sd[2] - 1]
        n is n - 1
        if n == 0:
            lr_throw of ((lr_where of (1)) + "calling '" + nm + "' on bad self")
    elif site != 0 and index_of of [sd[1], "'"] >= 0:
        local d is sd[1]
        nm is d[(index_of of [d, "'"]) + 1:len of d - 1]
    else:
        local g is lr_globalfuncname of (lr_st.curf)
        if g != null:
            nm is g
    lr_throw of ((lr_where of (1)) + "bad argument #" + (str of n) + " to '" + nm + "' (" + msg + ")")

define lr_globalfuncname(f) as:
    if f == null:
        return null
    for k in keys of lr_G.h:
        local v is lr_G.h[k]
        if (type of v == "fn" or type of v == "builtin") and lr_fnid of (v) == lr_fnid of (f):
            return k
    for lib in ["string", "table", "math", "io", "os", "coroutine", "utf8", "debug"]:
        local t is lr_G.h[lib]
        if type of t == "dict":
            for k in keys of t.h:
                local v is t.h[k]
                if (type of v == "fn" or type of v == "builtin") and lr_fnid of (v) == lr_fnid of (f):
                    return lib + "." + k
    return null

define lr_main(f, chunk, sites) as:
    lr_st.chunk is lr_chunkid of ("@" + chunk)
    lr_st.sites is sites
    lr_init_lib of null
    try:
        lr_call of [f, [], 0]
    catch e:
        local v is lr_errobj of (e)
        local msg is ""
        if type of v == "str":
            msg is v
        elif type of v == "num":
            msg is lr_tostr of (v)
        else:
            local h is lr_metafield of [v, "__tostring"]
            if h != null and type of v == "dict":
                msg is lr_tostr of (v)
            else:
                msg is "(error object is a " + (lr_type of (v)) + " value)"
        lr_stderr of ("lua: " + msg + "\n")
        lr_exit of 1
    lr_exit of 0

# The Lua value carried by a caught EigenScript error. A Lua error carries its
# value. Any other error is the VM refusing what the direct translation asked
# of it (a call-depth overflow, division by zero on a non-finite result, ...):
# owner decision 2 says let it surface, so it becomes a Lua error string
# naming the EigenScript error, and the row diverges where Lua would not raise.
define lr_errobj(e) as:
    if type of e == "dict" and e.LUAERR == 1:
        return e.v
    if type of e == "dict" and type of e.message == "str":
        return (lr_where of (1)) + "EigenScript " + (str of e.kind) + " error: " + e.message
    return (lr_where of (1)) + "EigenScript error: " + (str of e)

# ------------------------------------------------------------ values

define lr_type(v) as:
    local t is type of v
    if t == "num":
        return "number"
    if t == "str":
        return "string"
    if t == "dict":
        if v.ud == true:
            return "userdata"
        return "table"
    if t == "none":
        return "nil"
    if t == "bool":
        return "boolean"
    if t == "fn" or t == "builtin":
        return "function"
    if t == "list":
        return "thread"
    return "userdata"

# luaT_objtypename: a table or userdata with a string __name in its
# metatable is named by it in error messages.
define lr_tname(v) as:
    if type of v == "dict" and v.mt != null:
        local nm is v.mt.h["__name"]
        if type of nm == "str":
            return nm
    return lr_type of (v)

define lr_t(v) as:
    if v == null:
        return false
    if type of v == "bool":
        return v
    return true

define lr_not(v) as:
    if v == null:
        return true
    if type of v == "bool":
        return not v
    return false

define lr_and(a, b) as:
    if lr_t of (a):
        return b
    return a

define lr_or(a, b) as:
    if lr_t of (a):
        return a
    return b

define lr_at(l, i) as:
    if i < len of l:
        return l[i]
    return null

define lr_isint(x) as:
    return x == floor of x and x > -9223372036854775808.5 and x < 9223372036854775808

# ------------------------------------------------------------ numbers <-> strings

# Decimal digits of a non-negative integral double below 2^63, exactly.
define lr_intdigits(x) as:
    if x < 1e15:
        return str of x
    local b is f64_to_bytes of x
    local e2 is (bit_and of [b[0], 127]) * 16 + (floor of (b[1] / 16)) - 1075
    local m is (bit_and of [b[1], 15]) + 16
    for k in range of 6:
        m is m * 256 + b[k + 2]
    if e2 < 0:
        m is m / (pow of [2, 0 - e2])
        e2 is 0
    # m * 2^e2, e2 >= 0 here; base-1e7 limbs, least significant first
    local limbs is []
    loop while m > 0:
        local q is floor of (m / 10000000)
        local r is m - q * 10000000
        if r < 0:
            q is q - 1
            r is r + 10000000
        if r >= 10000000:
            q is q + 1
            r is r - 10000000
        append of [limbs, r]
        m is q
    for k in range of e2:
        local carry is 0
        for j in range of (len of limbs):
            local v is limbs[j] * 2 + carry
            carry is 0
            if v >= 10000000:
                v is v - 10000000
                carry is 1
            limbs[j] is v
        if carry:
            append of [limbs, 1]
    loop while len of limbs > 1 and limbs[len of limbs - 1] == 0:
        list_truncate of [limbs, len of limbs - 1]
    local s is str of limbs[len of limbs - 1]
    local j is len of limbs - 2
    loop while j >= 0:
        local d is str of limbs[j]
        loop while len of d < 7:
            d is "0" + d
        s is s + d
        j is j - 1
    return s

# C's %.<P>g for finite x (exact; src/rt_format.eigs).
define lr_fmt_g(x, P) as:
    if x < 0:
        return "-" + (lr_fx_g of [0 - x, P, false, false])
    return lr_fx_g of [x, P, false, false]

# Lua's number-to-string: integers (here: integral values below 2^63) in
# full, everything else %.14g. One double cannot tell 1 from 1.0, so integral
# floats print as integers: an EigenScript gap (gaps/no-float-subtype.eigs).
define lr_numstr(x) as:
    if lr_isint of (x):
        if x < 0:
            return "-" + (lr_intdigits of (0 - x))
        return lr_intdigits of (x)
    local g is lr_fmt_g of [x, 14]
    if index_of of [g, "."] < 0 and index_of of [g, "e"] < 0:
        return g + ".0"
    return g

define lr_isspace(c) as:
    return c == " " or c == "\t" or c == "\n" or c == "\r" or (ord of c) == 11 or (ord of c) == 12

define lr_hexval(c) as:
    local o is ord of c
    if o >= 48 and o <= 57:
        return o - 48
    if o >= 97 and o <= 102:
        return o - 87
    if o >= 65 and o <= 70:
        return o - 55
    return -1

define lr_isdigit(c) as:
    local o is ord of c
    return o >= 48 and o <= 57

# Lua's string->number conversion (lobject.c l_str2d / l_str2int), or null.
define lr_str2num(s) as:
    local n is len of s
    local i is 0
    loop while i < n and lr_isspace of (s[i]):
        i is i + 1
    loop while n > i and lr_isspace of (s[n - 1]):
        n is n - 1
    if i >= n:
        return null
    local neg is 0
    if s[i] == "-":
        neg is 1
        i is i + 1
    elif s[i] == "+":
        i is i + 1
    if i + 1 < n and s[i] == "0" and (s[i + 1] == "x" or s[i + 1] == "X"):
        i is i + 2
        local m is 0
        local ex is 0
        local any is 0
        loop while i < n and lr_hexval of (s[i]) >= 0:
            m is m * 16 + (lr_hexval of (s[i]))
            any is 1
            i is i + 1
        if i < n and s[i] == ".":
            i is i + 1
            loop while i < n and lr_hexval of (s[i]) >= 0:
                m is m * 16 + (lr_hexval of (s[i]))
                ex is ex - 4
                any is 1
                i is i + 1
        if any == 0:
            return null
        if i < n and (s[i] == "p" or s[i] == "P"):
            i is i + 1
            local es is 1
            if i < n and (s[i] == "+" or s[i] == "-"):
                if s[i] == "-":
                    es is -1
                i is i + 1
            if i >= n or not (lr_isdigit of (s[i])):
                return null
            local ev is 0
            loop while i < n and lr_isdigit of (s[i]):
                ev is ev * 10 + (ord of s[i]) - 48
                i is i + 1
            ex is ex + es * ev
        if i != n:
            return null
        local v is m
        if ex != 0:
            v is m * (pow of [2, ex])
        if neg:
            return 0 - v
        return v
    local st is i
    local nd is 0
    loop while i < n and lr_isdigit of (s[i]):
        i is i + 1
        nd is nd + 1
    if i < n and s[i] == ".":
        i is i + 1
        loop while i < n and lr_isdigit of (s[i]):
            i is i + 1
            nd is nd + 1
    if nd == 0:
        return null
    if i < n and (s[i] == "e" or s[i] == "E"):
        i is i + 1
        if i < n and (s[i] == "+" or s[i] == "-"):
            i is i + 1
        if i >= n or not (lr_isdigit of (s[i])):
            return null
        loop while i < n and lr_isdigit of (s[i]):
            i is i + 1
    if i != n:
        return null
    local text is s[st:n]
    if text[0] == ".":
        text is "0" + text
    if text[len of text - 1] == ".":
        text is text + "0"
    local v is num of text
    if neg:
        return 0 - v
    return v

define lr_tostr(v) as:
    local t is type of v
    if t == "str":
        return v
    if t == "bool":
        if v:
            return "true"
        return "false"
    if t == "num":
        return lr_numstr of (v)
    if t == "none":
        return "nil"
    if t == "dict":
        local h is lr_metafield of [v, "__tostring"]
        if h != null:
            local r is lr_call1 of [h, [v], 0]
            if type of r != "str":
                if type of r == "num":
                    return lr_numstr of (r)
                lr_throw of ((lr_where of (1)) + "'__tostring' must return a string")
            return r
        local nm is lr_metafield of [v, "__name"]
        if type of nm == "str":
            return nm + ": 0x" + (hex of [v.id, 8])
        return "table: 0x" + (hex of [v.id, 8])
    if t == "fn" or t == "builtin":
        return "function: 0x" + (hex of [lr_fnid of (v), 8])
    if t == "list":
        return "thread: 0x" + (hex of [v[0].id, 8])
    return "userdata"

define lr_fnid(f) as:
    local i is list_index_of of [lr_fnreg, f]
    if i < 0:
        append of [lr_fnreg, f]
        i is len of lr_fnreg - 1
    return i + 1

# ------------------------------------------------------------ tables

define lr_newtable as:
    lr_st.nid is lr_st.nid + 1
    return {"id": lr_st.nid, "a": [], "h": {}, "o": {}, "mt": null}

# Encoded key for the o part (numbers that are not array indices, tables,
# functions).
define lr_okey(k) as:
    local t is type of k
    if t == "bool":
        if k:
            return "b1"
        return "b0"
    if t == "num":
        if k == 0:
            return "n0"
        return "n" + (str of k)
    if t == "dict":
        return "t" + (str of k.id)
    if t == "list":
        return "c" + (str of k[0].id)
    return "f" + (str of (lr_fnid of (k)))

define lr_rawget(t, k) as:
    local tk is type of k
    if tk == "str":
        return t.h[k]
    if tk == "none":
        return null
    if tk == "num":
        local a is t.a
        if k >= 1 and k <= len of a and k == floor of k:
            return a[k - 1]
    local p is t.o[lr_okey of (k)]
    if p == null:
        return null
    return p[1]

define lr_rawset(t, k, v, site) as:
    local tk is type of k
    if tk == "str":
        if v == null:
            if has_key of [t.h, k]:
                dict_remove of [t.h, k]
        else:
            t.h[k] is v
        return null
    if tk == "none":
        lr_rterr of [site, "table index is nil"]
    if tk == "num":
        local a is t.a
        local n is len of a
        if k == floor of k and k >= 1 and k <= n + 1:
            if k <= n:
                a[k - 1] is v
                if v == null and k == n:
                    local m is n - 1
                    loop while m > 0 and a[m - 1] == null:
                        m is m - 1
                    list_truncate of [a, m]
                return null
            if v == null:
                return null
            append of [a, v]
            # migrate the keys that now continue the sequence
            local nk is lr_okey of (n + 2)
            loop while has_key of [t.o, nk]:
                append of [a, t.o[nk][1]]
                dict_remove of [t.o, nk]
                nk is lr_okey of (len of a + 1)
            return null
    local ek is lr_okey of (k)
    if v == null:
        if has_key of [t.o, ek]:
            dict_remove of [t.o, ek]
    else:
        t.o[ek] is [k, v]
    return null

define lr_tnew(pos, kv, site) as:
    local t is lr_newtable of null
    local i is 0
    loop while i < len of kv:
        if kv[i] == null:
            lr_rterr of [site, "table index is nil"]
        lr_rawset of [t, kv[i], kv[i + 1], site]
        i is i + 2
    local j is 0
    for v in pos:
        lr_rawset of [t, j + 1, v, site]
        j is j + 1
    return t

define lr_rawlen(t) as:
    return len of t.a

define lr_metatable(v) as:
    local t is type of v
    if t == "dict":
        return v.mt
    if t == "str":
        return lr_strmt
    return null

define lr_metafield(v, name) as:
    local mt is lr_metatable of (v)
    if mt == null:
        return null
    return mt.h[name]

# next(t, k) -> [key, value] or [null].
define lr_next(t, k) as:
    local a is t.a
    local na is len of a
    local i is 0
    local phase is 0
    if k == null:
        i is 0
    elif type of k == "num" and k >= 1 and k <= na and k == floor of k:
        i is k
    elif type of k == "str":
        phase is 1
    else:
        phase is 2
    if phase == 0:
        loop while i < na:
            if a[i] != null:
                return [i + 1, a[i]]
            i is i + 1
        phase is 1
        k is null
    if phase == 1:
        local hk is keys of t.h
        local j is 0
        if k != null:
            j is (list_index_of of [hk, k]) + 1
            if j == 0:
                lr_throw of ((lr_where of (1)) + "invalid key to 'next'")
        if j < len of hk:
            return [hk[j], t.h[hk[j]]]
        k is null
    local ok is keys of t.o
    local j2 is 0
    if k != null:
        j2 is (list_index_of of [ok, lr_okey of (k)]) + 1
        if j2 == 0:
            lr_throw of ((lr_where of (1)) + "invalid key to 'next'")
    if j2 < len of ok:
        local p is t.o[ok[j2]]
        return [p[0], p[1]]
    return [null]

# ------------------------------------------------------------ index / call

define lr_index(o, k, site) as:
    local d is 0
    loop while d < 2000:
        local t is type of o
        if t == "dict":
            local v is lr_rawget of [o, k]
            if v != null or o.mt == null:
                if v == null and has_key of [o, "trap"] and type of k == "str" and has_key of [o.trap, k]:
                    lr_unsup of [o.trap[k], site]
                return v
            local h is o.mt.h["__index"]
            if h == null:
                if has_key of [o, "trap"] and type of k == "str" and has_key of [o.trap, k]:
                    lr_unsup of [o.trap[k], site]
                return null
            if type of h == "fn" or type of h == "builtin":
                return lr_callmm1 of [h, "index", [o, k], site]
            o is h
        elif t == "str":
            o is lr_strlib
        else:
            local h2 is lr_metafield of [o, "__index"]
            if h2 == null:
                lr_idxerr of [o, k, site, d]
            if type of h2 == "fn":
                return lr_callmm1 of [h2, "index", [o, k], site]
            o is h2
        d is d + 1
    lr_rterr of [site, "'__index' chain too long; possible loop"]

define lr_idxerr(o, k, site, depth) as:
    local sd is lr_st.sites[site]
    local desc is ""
    if depth == 0 and sd[1] != "":
        desc is " (" + sd[1] + ")"
    elif depth == 0 and type of k == "str":
        desc is " (field '" + k + "')"
    lr_rterr of [site, "attempt to index a " + (lr_tname of (o)) + " value" + desc]

define lr_setindex(o, k, v, site) as:
    local d is 0
    loop while d < 2000:
        if type of o == "dict":
            if o.mt == null:
                lr_rawset of [o, k, v, site]
                return null
            local h is o.mt.h["__newindex"]
            if h == null or lr_rawget of [o, k] != null:
                lr_rawset of [o, k, v, site]
                return null
            if type of h == "fn" or type of h == "builtin":
                lr_callmm of [h, "newindex", [o, k, v], site]
                return null
            o is h
        else:
            local h2 is lr_metafield of [o, "__newindex"]
            if h2 == null:
                lr_idxerr of [o, k, site, d]
            if type of h2 == "fn":
                lr_callmm of [h2, "newindex", [o, k, v], site]
                return null
            o is h2
        d is d + 1
    lr_rterr of [site, "'__newindex' chain too long; possible loop"]

define lr_gget(name, site) as:
    return lr_index of [lr_G, name, site]

define lr_gset(name, v, site) as:
    lr_setindex of [lr_G, name, v, site]

define lr_call(f, args, site) as:
    local tf is type of f
    if tf == "fn":
        if site == 0:
            lr_st.curf is f
        append of [lr_stk, site]
        local r is f of (args)
        list_truncate of [lr_stk, len of lr_stk - 1]
        return r
    local h is lr_metafield of [f, "__call"]
    if h != null:
        return lr_call of [h, concat of [[f], args], site]
    local sd is lr_st.sites[site]
    local desc is ""
    if sd[1] != "":
        desc is " (" + sd[1] + ")"
    lr_rterr of [site, "attempt to call a " + (lr_tname of (f)) + " value" + desc]

# Call metamethod h for event ev ("add", "index", ...): Lua names it in the
# error when it cannot be called.
define lr_callmm(h, ev, args, site) as:
    if type of h != "fn" and type of h != "builtin" and lr_metafield of [h, "__call"] == null:
        lr_rterr of [site, "attempt to call a " + (lr_tname of (h)) + " value (metamethod '" + ev + "')"]
    return lr_call of [h, args, site]

define lr_callmm1(h, ev, args, site) as:
    local r is lr_callmm of [h, ev, args, site]
    if len of r > 0:
        return r[0]
    return null

define lr_call1(f, args, site) as:
    local r is lr_call of [f, args, site]
    if len of r > 0:
        return r[0]
    return null

# o:m(args) once the method f = o.m has been looked up; a call error names
# the method (the site's second description).
define lr_mcall(f, o, args, site) as:
    if type of f != "fn" and lr_metafield of [f, "__call"] == null:
        lr_rterr of [site, "attempt to call a " + (lr_tname of (f)) + " value (" + lr_st.sites[site][2] + ")"]
    return lr_call of [f, concat of [[o], args], site]

define lr_mcall1(f, o, args, site) as:
    local r is lr_mcall of [f, o, args, site]
    if len of r > 0:
        return r[0]
    return null

# ------------------------------------------------------------ arithmetic

# Operand as a number for arithmetic (strings convert), else null.
define lr_arnum(v) as:
    local t is type of v
    if t == "num":
        return v
    if t == "str":
        return lr_str2num of (v)
    return null

define lr_arith_ev(name) as:
    local m is {"+": "__add", "-": "__sub", "*": "__mul", "/": "__div", "%": "__mod", "//": "__idiv", "^": "__pow", "u-": "__unm", "&": "__band", "|": "__bor", "~": "__bxor", "<<": "__shl", ">>": "__shr", "u~": "__bnot"}
    return m[name]

# Slow path: metamethods, then the error naming the bad operand.
define lr_arith_meta(op, a, b, site) as:
    local ev is lr_arith_ev of (op)
    local h is lr_metafield of [a, ev]
    if h == null:
        h is lr_metafield of [b, ev]
    if h != null:
        return lr_callmm1 of [h, ev[2:], [a, b], site]
    local sd is lr_st.sites[site]
    local bad is b
    local desc is sd[2]
    local isbit is op == "&" or op == "|" or op == "~" or op == "<<" or op == ">>" or op == "u~"
    if isbit:
        if type of a != "num" and (type of a != "str" or lr_str2num of (a) == null):
            bad is a
            desc is sd[1]
        elif type of b == "num" or (type of b == "str" and lr_str2num of (b) != null):
            lr_rterr of [site, "number has no integer representation"]
    elif lr_arnum of (a) == null:
        bad is a
        desc is sd[1]
    if desc != "":
        desc is " (" + desc + ")"
    if isbit:
        lr_rterr of [site, "attempt to perform bitwise operation on a " + (lr_tname of (bad)) + " value" + desc]
    if type of a == "str" or type of b == "str":
        # the string library's arithmetic metamethods (lstrlib.c trymt)
        local opn is {"+": "add", "-": "sub", "*": "mul", "/": "div", "%": "mod", "//": "idiv", "^": "pow", "u-": "unm"}
        lr_rterr of [site, "attempt to " + opn[op] + " a '" + (lr_type of (a)) + "' with a '" + (lr_type of (b)) + "'"]
    lr_rterr of [site, "attempt to perform arithmetic on a " + (lr_tname of (bad)) + " value" + desc]

define lr_arith(op, a, b, site) as:
    local x is lr_arnum of (a)
    local y is lr_arnum of (b)
    if x == null or y == null or (type of a == "str" and lr_metafield of [b, lr_arith_ev of (op)] != null and type of b == "dict") or (type of b == "str" and type of a == "dict"):
        return lr_arith_meta of [op, a, b, site]
    return lr_arith_num of [op, x, y, site]

define lr_arith_num(op, x, y, site) as:
    if op == "+":
        return x + y
    if op == "-":
        return x - y
    if op == "*":
        return x * y
    if op == "/":
        return x / y
    if op == "%":
        return lr_modnum of [x, y, site]
    if op == "//":
        return lr_idivnum of [x, y, site]
    if op == "^":
        return lr_pownum of [x, y, site]
    throw of (["INTERNAL", "arith op " + op])

define lr_add(a, b, site) as:
    if type of a == "num" and type of b == "num":
        return a + b
    return lr_arith of ["+", a, b, site]

define lr_sub(a, b, site) as:
    if type of a == "num" and type of b == "num":
        return a - b
    return lr_arith of ["-", a, b, site]

define lr_mul(a, b, site) as:
    if type of a == "num" and type of b == "num":
        return a * b
    return lr_arith of ["*", a, b, site]

define lr_div(a, b, site) as:
    return lr_arith of ["/", a, b, site]

define lr_mod(a, b, site) as:
    return lr_arith of ["%", a, b, site]

define lr_idiv(a, b, site) as:
    return lr_arith of ["//", a, b, site]

define lr_pow(a, b, site) as:
    return lr_arith of ["^", a, b, site]

# Integral operands follow Lua's integer rules (one double cannot tell an
# integer from an integral float; see lr_numstr), the rest float rules.
define lr_modnum(x, y, site) as:
    if y == 0:
        if lr_isint of (x) and lr_isint of (y):
            lr_rterr of [site, "attempt to perform 'n%0'"]
    local m is x % y
    if m != 0 and (m < 0) != (y < 0):
        m is m + y
    return m

define lr_idivnum(x, y, site) as:
    if y == 0:
        if lr_isint of (x) and lr_isint of (y):
            lr_rterr of [site, "attempt to divide by zero"]
    return floor of (x / y)

define lr_pownum(x, y, site) as:
    return pow of [x, y]

define lr_unm(a, site) as:
    if type of a == "num":
        return 0 - a
    local x is lr_arnum of (a)
    if x != null and type of a == "str":
        return 0 - x
    local h is lr_metafield of [a, "__unm"]
    if h != null:
        return lr_callmm1 of [h, "unm", [a, a], site]
    local sd is lr_st.sites[site]
    local desc is ""
    if sd[1] != "":
        desc is " (" + sd[1] + ")"
    lr_rterr of [site, "attempt to perform arithmetic on a " + (lr_tname of (a)) + " value" + desc]

# ------------------------------------------------------------ bitwise

define lr_toint(v) as:
    local x is lr_arnum of (v)
    if x == null:
        return null
    if x != floor of x or x < -9223372036854775808 or x >= 9223372036854775808:
        return null
    return x

define lr_bitop(op, a, b, site) as:
    local x is lr_toint of (a)
    local y is lr_toint of (b)
    if x == null or y == null:
        return lr_arith_meta of [op, a, b, site]
    if op == "&":
        return x & y
    if op == "|":
        return x | y
    if op == "~":
        return x ^ y
    if op == "<<":
        return lr_shiftl of [x, y]
    return lr_shiftl of [x, 0 - y]

define lr_shiftl(x, n) as:
    if n <= -64 or n >= 64:
        return 0
    if n >= 0:
        return x << n
    if x >= 0:
        return x >> (0 - n)
    # logical shift of a negative int64
    local s is 0 - n
    return (x >> s) & ((1 << (64 - s)) - 1)

define lr_band(a, b, site) as:
    return lr_bitop of ["&", a, b, site]

define lr_bor(a, b, site) as:
    return lr_bitop of ["|", a, b, site]

define lr_bxor(a, b, site) as:
    return lr_bitop of ["~", a, b, site]

define lr_shl(a, b, site) as:
    return lr_bitop of ["<<", a, b, site]

define lr_shr(a, b, site) as:
    return lr_bitop of [">>", a, b, site]

define lr_bnot(a, site) as:
    local x is lr_toint of (a)
    if x == null:
        return lr_arith_meta of ["u~", a, a, site]
    return ~x

# ------------------------------------------------------------ comparison

define lr_eq(a, b, site) as:
    local ta is type of a
    if ta != type of b:
        return false
    if ta == "dict":
        if a.id == b.id:
            return true
        local h is lr_metafield of [a, "__eq"]
        if h == null:
            h is lr_metafield of [b, "__eq"]
        if h == null:
            return false
        return lr_t of (lr_callmm1 of [h, "eq", [a, b], site])
    if ta == "fn" or ta == "builtin":
        return lr_fnid of (a) == lr_fnid of (b)
    if ta == "list":
        return a[0].id == b[0].id
    return a == b

define lr_ne(a, b, site) as:
    return not (lr_eq of [a, b, site])

define lr_cmperr(a, b, site) as:
    local t1 is lr_tname of (a)
    local t2 is lr_tname of (b)
    if t1 == t2:
        lr_rterr of [site, "attempt to compare two " + t1 + " values"]
    lr_rterr of [site, "attempt to compare " + t1 + " with " + t2]

define lr_lt(a, b, site) as:
    local ta is type of a
    local tb is type of b
    if (ta == "num" and tb == "num") or (ta == "str" and tb == "str"):
        return a < b
    local h is lr_metafield of [a, "__lt"]
    if h == null:
        h is lr_metafield of [b, "__lt"]
    if h == null:
        lr_cmperr of [a, b, site]
    return lr_t of (lr_callmm1 of [h, "lt", [a, b], site])

define lr_le(a, b, site) as:
    local ta is type of a
    local tb is type of b
    if (ta == "num" and tb == "num") or (ta == "str" and tb == "str"):
        return a <= b
    local h is lr_metafield of [a, "__le"]
    if h == null:
        h is lr_metafield of [b, "__le"]
    if h == null:
        lr_cmperr of [a, b, site]
    return lr_t of (lr_callmm1 of [h, "le", [a, b], site])

define lr_gt(a, b, site) as:
    return lr_lt of [b, a, site]

define lr_ge(a, b, site) as:
    return lr_le of [b, a, site]

# ------------------------------------------------------------ concat / len

define lr_concat(a, b, site) as:
    local ta is type of a
    local tb is type of b
    if (ta == "str" or ta == "num") and (tb == "str" or tb == "num"):
        local sa is a
        local sb is b
        if ta == "num":
            sa is lr_numstr of (a)
        if tb == "num":
            sb is lr_numstr of (b)
        return sa + sb
    local h is lr_metafield of [a, "__concat"]
    if h == null:
        h is lr_metafield of [b, "__concat"]
    if h != null:
        return lr_callmm1 of [h, "concat", [a, b], site]
    local sd is lr_st.sites[site]
    local bad is a
    local desc is sd[1]
    if ta == "str" or ta == "num":
        bad is b
        desc is sd[2]
    if desc != "":
        desc is " (" + desc + ")"
    lr_rterr of [site, "attempt to concatenate a " + (lr_tname of (bad)) + " value" + desc]

define lr_len(a, site) as:
    local ta is type of a
    if ta == "str":
        return len of a
    local h is lr_metafield of [a, "__len"]
    if h != null:
        return lr_callmm1 of [h, "len", [a], site]
    if ta == "dict":
        return len of a.a
    local sd is lr_st.sites[site]
    local desc is ""
    if sd[1] != "":
        desc is " (" + sd[1] + ")"
    lr_rterr of [site, "attempt to get length of a " + (lr_tname of (a)) + " value" + desc]

# ------------------------------------------------------------ numeric for

# [initial, limit*sign, step, sign, count]; Lua 5.4's 'for' checks. count is
# the number of iterations of an integer loop, -1 for a float loop.
define lr_forprep(a, b, c, site) as:
    if type of a != "num":
        lr_rterr of [site, "bad 'for' initial value (number expected, got " + (lr_tname of (a)) + ")"]
    if type of b != "num":
        lr_rterr of [site, "bad 'for' limit (number expected, got " + (lr_tname of (b)) + ")"]
    if type of c != "num":
        lr_rterr of [site, "bad 'for' step (number expected, got " + (lr_tname of (c)) + ")"]
    if c == 0:
        lr_rterr of [site, "'for' step is zero"]
    local lim is b
    if lr_isint of (a) and lr_isint of (c):
        # an integer loop runs a precomputed number of times (lvm.c
        # forprep), so it ends even where a double absorbs the step
        if c > 0:
            lim is floor of b
            if a > lim:
                return [a, 0, c, 1, 0]
        else:
            lim is ceil of b
            if a < lim:
                return [a, 0, c, 1, 0]
        return [a, 0, c, 1, (floor of ((lim - a) / c)) + 1]
    if c > 0:
        return [a, lim, c, 1, -1]
    return [a, 0 - lim, c, -1, -1]

# ------------------------------------------------------------ library helpers

define lr_arg(A, i) as:
    if i < len of A:
        return A[i]
    return null

define lr_checktable(A, i, fname) as:
    local v is lr_arg of [A, i]
    if type of v != "dict":
        lr_argerr of [i + 1, fname, "table expected, got " + (lr_typearg of [A, i])]
    return v

define lr_typearg(A, i) as:
    if i >= len of A:
        return "no value"
    return lr_tname of (A[i])

define lr_checknum(A, i, fname) as:
    local v is lr_arg of [A, i]
    local x is lr_arnum of (v)
    if x == null:
        lr_argerr of [i + 1, fname, "number expected, got " + (lr_typearg of [A, i])]
    return x

define lr_checkint(A, i, fname) as:
    local x is lr_checknum of [A, i, fname]
    if x != floor of x or x < -9223372036854775808 or x >= 9223372036854775808:
        lr_argerr of [i + 1, fname, "number has no integer representation"]
    return x

define lr_optint(A, i, fname, d) as:
    if lr_arg of [A, i] == null:
        return d
    return lr_checkint of [A, i, fname]

define lr_checkstr(A, i, fname) as:
    local v is lr_arg of [A, i]
    if type of v == "str":
        return v
    if type of v == "num":
        return lr_numstr of (v)
    lr_argerr of [i + 1, fname, "string expected, got " + (lr_typearg of [A, i])]

# A library function that is not implemented: calling it exits 3.
define lr_stub(name) as:
    define stub(A) as:
        lr_unsup of [name, 0]
    return stub

# ------------------------------------------------------------ base library

define lr_b_print(A) as:
    local parts is []
    for v in A:
        append of [parts, lr_tostr of (v)]
    print of (join of [parts, "\t"])
    return []

define lr_b_type(A) as:
    if len of A == 0:
        lr_argerr of [1, "type", "value expected"]
    return [lr_type of (A[0])]

define lr_b_tostring(A) as:
    if len of A == 0:
        lr_argerr of [1, "tostring", "value expected"]
    return [lr_tostr of (A[0])]

define lr_b_tonumber(A) as:
    local v is lr_arg of [A, 0]
    local base is lr_arg of [A, 1]
    if base == null:
        if type of v == "num":
            return [v]
        if type of v == "str":
            return [lr_str2num of (v)]
        if len of A == 0:
            lr_argerr of [1, "tonumber", "value expected"]
        return [null]
    local bs is lr_checkint of [A, 1, "tonumber"]
    if type of v != "str":
        lr_argerr of [1, "tonumber", "string expected, got " + (lr_typearg of [A, 0])]
    if bs < 2 or bs > 36:
        lr_argerr of [2, "tonumber", "base out of range"]
    local s is str_lower of (trim of v)
    local neg is 0
    if len of s > 0 and s[0] == "-":
        neg is 1
        s is s[1:]
    if len of s == 0:
        return [null]
    local acc is 0
    for i in range of (len of s):
        local d is lr_hexval of (s[i])
        local o is ord of s[i]
        if o >= 97 and o <= 122:
            d is o - 87
        if d < 0 or d >= bs:
            return [null]
        acc is acc * bs + d
    if neg:
        return [0 - acc]
    return [acc]

define lr_b_error(A) as:
    local msg is lr_arg of [A, 0]
    local level is lr_arg of [A, 1]
    if level == null:
        level is 1
    if type of msg == "str" and level > 0:
        msg is (lr_where of (level)) + msg
    throw of ({"LUAERR": 1, "v": msg})

define lr_b_assert(A) as:
    lr_st.asserts is lr_st.asserts + 1
    if len of A == 0:
        lr_argerr of [1, "assert", "value expected"]
    if lr_t of (A[0]):
        return A
    local msg is "assertion failed!"
    if len of A >= 2:
        msg is A[1]
    if type of msg == "str":
        msg is (lr_where of (1)) + msg
    throw of ({"LUAERR": 1, "v": msg})

define lr_b_pcall(A) as:
    if len of A == 0:
        lr_argerr of [1, "pcall", "value expected"]
    local depth is len of lr_stk
    local r is null
    try:
        r is lr_call of [A[0], list_slice of [A, 1, len of A], 0]
    catch e:
        if type of e == "dict" and e.COCLOSE == 1:
            throw of (e)
        list_truncate of [lr_stk, depth]
        return [false, lr_errobj of (e)]
    return concat of [[true], r]

define lr_b_xpcall(A) as:
    local h is lr_arg of [A, 1]
    local depth is len of lr_stk
    local r is null
    try:
        r is lr_call of [lr_arg of [A, 0], list_slice of [A, 2, len of A], 0]
    catch e:
        if type of e == "dict" and e.COCLOSE == 1:
            throw of (e)
        local v is lr_errobj of (e)
        list_truncate of [lr_stk, depth]
        return [false, lr_call1 of [h, [v], 0]]
    return concat of [[true], r]

define lr_b_select(A) as:
    local n is lr_arg of [A, 0]
    if n == "#":
        return [len of A - 1]
    local i is lr_checkint of [A, 0, "select"]
    if i < 0:
        i is len of A + i
        if i < 1:
            lr_argerr of [1, "select", "index out of range"]
        return list_slice of [A, i, len of A]
    if i == 0:
        lr_argerr of [1, "select", "index out of range"]
    if i >= len of A:
        return []
    return list_slice of [A, i, len of A]

define lr_b_rawget(A) as:
    local t is lr_checktable of [A, 0, "rawget"]
    return [lr_rawget of [t, lr_arg of [A, 1]]]

define lr_b_rawset(A) as:
    local t is lr_checktable of [A, 0, "rawset"]
    lr_rawset of [t, lr_arg of [A, 1], lr_arg of [A, 2], 0]
    return [t]

define lr_b_rawequal(A) as:
    local a is lr_arg of [A, 0]
    local b is lr_arg of [A, 1]
    if type of a != type of b:
        return [false]
    if type of a == "dict":
        return [a.id == b.id]
    if type of a == "fn" or type of a == "builtin":
        return [lr_fnid of (a) == lr_fnid of (b)]
    if type of a == "list":
        return [a[0].id == b[0].id]
    return [a == b]

define lr_b_rawlen(A) as:
    local v is lr_arg of [A, 0]
    if type of v == "dict":
        return [len of v.a]
    if type of v == "str":
        return [len of v]
    lr_argerr of [1, "rawlen", "table or string expected"]

define lr_b_setmetatable(A) as:
    local t is lr_checktable of [A, 0, "setmetatable"]
    local mt is lr_arg of [A, 1]
    if mt != null and type of mt != "dict":
        lr_argerr of [2, "setmetatable", "nil or table expected"]
    if t.mt != null and lr_rawget of [t.mt, "__metatable"] != null:
        lr_throw of ((lr_where of (1)) + "cannot change a protected metatable")
    t.mt is mt
    return [t]

define lr_b_getmetatable(A) as:
    local mt is lr_metatable of (lr_arg of [A, 0])
    if mt == null:
        return [null]
    local p is lr_rawget of [mt, "__metatable"]
    if p != null:
        return [p]
    return [mt]

define lr_b_next(A) as:
    local t is lr_checktable of [A, 0, "next"]
    return lr_next of [t, lr_arg of [A, 1]]

# pairs: a snapshot iterator over the keys present at the start; a key whose
# value became nil during the traversal is skipped (manual: assigning nil to
# existing fields during traversal is allowed).
define lr_b_pairs(A) as:
    local t is lr_arg of [A, 0]
    local h is lr_metafield of [t, "__pairs"]
    if h != null:
        local r is lr_call of [h, [t], 0]
        return [lr_at of [r, 0], lr_at of [r, 1], lr_at of [r, 2]]
    if type of t != "dict":
        lr_argerr of [1, "pairs", "table expected, got " + (lr_typearg of [A, 0])]
    local ks is []
    for i in range of (len of t.a):
        if t.a[i] != null:
            append of [ks, i + 1]
    for k in keys of t.h:
        append of [ks, k]
    for k in keys of t.o:
        append of [ks, t.o[k][0]]
    local st is {"i": 0}
    define pairs_iter(B) as:
        loop while st.i < len of ks:
            local k is ks[st.i]
            st.i is st.i + 1
            local v is lr_rawget of [t, k]
            if v != null:
                return [k, v]
        return [null]
    return [pairs_iter, t, null]

define lr_ipairs_iter(A) as:
    local i is A[1] + 1
    local v is lr_index of [A[0], i, 0]
    if v == null:
        return [null]
    return [i, v]

define lr_b_ipairs(A) as:
    if len of A == 0:
        lr_argerr of [1, "ipairs", "table expected, got no value"]
    return [lr_ipairs_iter, A[0], 0]

# collectgarbage: EigenScript manages memory itself, so there is no cycle
# to run; the options answer with lbaselib.c's result shapes (counts and
# step results are out of scope, GAPS.md).
define lr_b_collectgarbage(A) as:
    local opt is "collect"
    if lr_arg of [A, 0] != null:
        opt is lr_checkstr of [A, 0, "collectgarbage"]
    if opt == "collect":
        return [0]
    if opt == "stop":
        lr_st.gcrun is false
        return [0]
    if opt == "restart":
        lr_st.gcrun is true
        return [0]
    if opt == "count":
        return [0]
    if opt == "step":
        return [true]
    if opt == "isrunning":
        return [lr_st.gcrun != false]
    if opt == "incremental" or opt == "generational":
        local prev is lr_st.gcmode
        if prev == null:
            prev is "incremental"
        lr_st.gcmode is opt
        return [prev]
    if opt == "setpause" or opt == "setstepmul":
        return [100]
    lr_argerr of [1, "collectgarbage", "invalid option '" + opt + "'"]

# ------------------------------------------------------------ string library

define lr_strindex(i, n) as:
    if i > 0:
        return i
    if i == 0:
        return 1
    if i < 0 - n:
        return 1
    return n + i + 1

define lr_s_sub(A) as:
    local s is lr_checkstr of [A, 0, "sub"]
    local n is len of s
    local i is lr_optint of [A, 1, "sub", 1]
    local j is lr_optint of [A, 2, "sub", -1]
    if i < 0:
        i is n + i + 1
        if i < 1:
            i is 1
    elif i == 0:
        i is 1
    if j < 0:
        j is n + j + 1
    elif j > n:
        j is n
    if i > j:
        return [""]
    return [s[i - 1:j]]

define lr_s_len(A) as:
    return [len of (lr_checkstr of [A, 0, "len"])]

define lr_s_upper(A) as:
    return [str_upper of (lr_checkstr of [A, 0, "upper"])]

define lr_s_lower(A) as:
    return [str_lower of (lr_checkstr of [A, 0, "lower"])]

define lr_s_rep(A) as:
    local s is lr_checkstr of [A, 0, "rep"]
    local n is lr_checkint of [A, 1, "rep"]
    local sep is lr_arg of [A, 2]
    if n <= 0:
        return [""]
    local parts is []
    for i in range of n:
        append of [parts, s]
    if sep == null:
        return [join of [parts, ""]]
    return [join of [parts, lr_checkstr of [A, 2, "rep"]]]

define lr_s_reverse(A) as:
    local s is lr_checkstr of [A, 0, "reverse"]
    local parts is []
    local i is len of s - 1
    loop while i >= 0:
        append of [parts, s[i]]
        i is i - 1
    return [join of [parts, ""]]

define lr_s_byte(A) as:
    local s is lr_checkstr of [A, 0, "byte"]
    local n is len of s
    local i is lr_optint of [A, 1, "byte", 1]
    local j is lr_optint of [A, 2, "byte", i]
    if i < 0:
        i is n + i + 1
        if i < 1:
            i is 1
    elif i == 0:
        i is 1
    if j < 0:
        j is n + j + 1
    elif j > n:
        j is n
    local out is []
    local k is i
    loop while k <= j:
        append of [out, ord of s[k - 1]]
        k is k + 1
    return out

define lr_s_char(A) as:
    local bs is []
    local i is 0
    for v in A:
        local c is lr_checkint of [A, i, "char"]
        if c < 0 or c > 255:
            lr_argerr of [i + 1, "char", "value out of range"]
        append of [bs, c]
        i is i + 1
    # direct translation: a NUL byte ends the EigenScript string
    return [str_from_bytes of (bs)]

# ------------------------------------------------------------ table library

define lr_t_insert(A) as:
    local t is lr_checktable of [A, 0, "insert"]
    local n is (lr_len of [t, 0])
    if len of A == 2:
        lr_setindex of [t, n + 1, A[1], 0]
        return []
    if len of A != 3:
        lr_throw of ((lr_where of (1)) + "wrong number of arguments to 'insert'")
    local pos is lr_checkint of [A, 1, "insert"]
    if pos < 1 or pos > n + 1:
        lr_argerr of [2, "insert", "position out of bounds"]
    local i is n
    loop while i >= pos:
        lr_setindex of [t, i + 1, lr_index of [t, i, 0], 0]
        i is i - 1
    lr_setindex of [t, pos, A[2], 0]
    return []

define lr_t_remove(A) as:
    local t is lr_checktable of [A, 0, "remove"]
    local n is (lr_len of [t, 0])
    if len of A < 2:
        if n == 0:
            return [null]
        local v is lr_index of [t, n, 0]
        lr_setindex of [t, n, null, 0]
        return [v]
    local pos is lr_checkint of [A, 1, "remove"]
    if n + 1 == pos:
        local v2 is lr_index of [t, pos, 0]
        lr_setindex of [t, pos, null, 0]
        return [v2]
    if n == 0 and pos == 0:
        return [lr_index of [t, pos, 0]]
    if pos < 1 or pos > n + 1:
        lr_argerr of [2, "remove", "position out of bounds"]
    local v3 is lr_index of [t, pos, 0]
    local i is pos
    loop while i < n:
        lr_setindex of [t, i, lr_index of [t, i + 1, 0], 0]
        i is i + 1
    lr_setindex of [t, n, null, 0]
    return [v3]

define lr_t_concat(A) as:
    local t is lr_checktable of [A, 0, "concat"]
    local sep is ""
    if lr_arg of [A, 1] != null:
        sep is lr_checkstr of [A, 1, "concat"]
    local i is lr_optint of [A, 2, "concat", 1]
    local j is 0
    if lr_arg of [A, 3] == null:
        j is lr_len of [t, 0]
    else:
        j is lr_checkint of [A, 3, "concat"]
    local parts is []
    local k is i
    loop while k <= j:
        local v is lr_index of [t, k, 0]
        if type of v == "str":
            append of [parts, v]
        elif type of v == "num":
            append of [parts, lr_numstr of (v)]
        else:
            lr_throw of ((lr_where of (1)) + "invalid value (at index " + (str of k) + ") in table for 'concat'")
        k is k + 1
    return [join of [parts, sep]]

define lr_t_pack(A) as:
    local t is lr_tnew of [A, [], 0]
    lr_rawset of [t, "n", len of A, 0]
    return [t]

define lr_t_unpack(A) as:
    local t is lr_arg of [A, 0]
    local i is lr_optint of [A, 1, "unpack", 1]
    local j is 0
    if lr_arg of [A, 2] == null:
        j is lr_len of [t, 0]
    else:
        j is lr_checkint of [A, 2, "unpack"]
    if i > j:
        return []
    # n + 1 elements, counted as ltablib.c does (the stack holds about 1e6)
    local n is j - i
    if n >= 999900:
        lr_throw of ((lr_where of (1)) + "too many results to unpack")
    local out is []
    local k is 0
    loop while k < n:
        append of [out, lr_index of [t, i + k, 0]]
        k is k + 1
    append of [out, lr_index of [t, j, 0]]
    return out

# table.sort: merge sort (stable, which Lua's is not required to be; the
# order of equal elements is unspecified, so any order is conforming).
define lr_t_sort(A) as:
    local t is lr_checktable of [A, 0, "sort"]
    local cmp is lr_arg of [A, 1]
    local n is lr_len of [t, 0]
    local xs is []
    for i in range of n:
        append of [xs, lr_index of [t, i + 1, 0]]
    local sorted is lr_msort of [xs, cmp]
    for i in range of n:
        lr_setindex of [t, i + 1, sorted[i], 0]
    return []

define lr_less(a, b, cmp) as:
    if cmp == null:
        return lr_lt of [a, b, 0]
    return lr_t of (lr_call1 of [cmp, [a, b], 0])

define lr_msort(xs, cmp) as:
    local n is len of xs
    if n <= 1:
        return xs
    local mid is floor of (n / 2)
    local l is lr_msort of [list_slice of [xs, 0, mid], cmp]
    local r is lr_msort of [list_slice of [xs, mid, n], cmp]
    local out is []
    local i is 0
    local j is 0
    loop while i < len of l and j < len of r:
        if lr_less of [r[j], l[i], cmp]:
            append of [out, r[j]]
            j is j + 1
        else:
            append of [out, l[i]]
            i is i + 1
    loop while i < len of l:
        append of [out, l[i]]
        i is i + 1
    loop while j < len of r:
        append of [out, r[j]]
        j is j + 1
    return out

# ------------------------------------------------------------ math library

define lr_m_floor(A) as:
    local x is lr_checknum of [A, 0, "floor"]
    return [floor of x]

define lr_m_ceil(A) as:
    local x is lr_checknum of [A, 0, "ceil"]
    return [ceil of x]

define lr_m_abs(A) as:
    local x is lr_checknum of [A, 0, "abs"]
    return [abs of x]

define lr_m_sqrt(A) as:
    local x is lr_checknum of [A, 0, "sqrt"]
    return [sqrt of x]

define lr_m_max(A) as:
    local m is lr_checknum of [A, 0, "max"]
    local i is 1
    loop while i < len of A:
        local x is lr_checknum of [A, i, "max"]
        if x > m:
            m is x
        i is i + 1
    return [m]

define lr_m_min(A) as:
    local m is lr_checknum of [A, 0, "min"]
    local i is 1
    loop while i < len of A:
        local x is lr_checknum of [A, i, "min"]
        if x < m:
            m is x
        i is i + 1
    return [m]

# math.type: one double cannot tell an integer from an integral float, so
# every integral value answers "integer" (EigenScript gap).
define lr_m_type(A) as:
    if len of A == 0:
        lr_argerr of [1, "type", "value expected"]
    local x is A[0]
    if type of x != "num":
        return [null]
    if lr_isint of (x):
        return ["integer"]
    return ["float"]

define lr_m_tointeger(A) as:
    local x is lr_arg of [A, 0]
    if type of x == "num" and lr_isint of (x):
        return [x]
    return [null]

define lr_m_fmod(A) as:
    local a is lr_checknum of [A, 0, "fmod"]
    local b is lr_checknum of [A, 1, "fmod"]
    if b == 0:
        if lr_isint of (a) and lr_isint of (b):
            lr_argerr of [2, "fmod", "zero"]
    return [a % b]

# ------------------------------------------------------------ io / os

define lr_os_exit(A) as:
    local c is lr_arg of [A, 0]
    if c == null:
        c is 0
    elif type of c == "bool":
        if c:
            c is 0
        else:
            c is 1
    lr_exit of c

# os.clock: processor time is not observable here; the seconds since the
# program started stand in (its value is out of scope, GAPS.md).
define lr_os_clock(A) as:
    return [(clock_unix of null) - lr_st.t0]

define lr_os_time(A) as:
    if lr_arg of [A, 0] != null:
        lr_unsup of ["os.time with a date table", 0]
    return [floor of (clock_unix of null)]

define lr_os_difftime(A) as:
    return [(lr_checknum of [A, 0, "difftime"]) - (lr_checknum of [A, 1, "difftime"])]

define lr_os_getenv(A) as:
    local v is env_get of (lr_checkstr of [A, 0, "getenv"])
    # env_get answers "" for an unset variable, so an empty one reads as unset
    if type of v != "str" or v == "":
        return [null]
    return [v]

# Only the C locale exists (os.setlocale answers as a C library would).
define lr_os_setlocale(A) as:
    local l is lr_arg of [A, 0]
    if l == null or l == "" or l == "C" or l == "POSIX":
        return ["C"]
    return [null]

# ------------------------------------------------------------ load

# luaO_chunkid with LUA_IDSIZE 60: how a chunk name appears in messages.
define lr_chunkid(src) as:
    local n is len of src
    if n > 0 and src[0] == "=":
        if n <= 60:
            return src[1:]
        return src[1:60]
    if n > 0 and src[0] == "@":
        if n <= 60:
            return src[1:]
        return "..." + src[n - 56:]
    local nl is index_of of [src, "\n"]
    if n < 45 and nl < 0:
        return "[string \"" + src + "\"]"
    local m is n
    if nl >= 0:
        m is nl
    if m > 45:
        m is 45
    return "[string \"" + src[0:m] + "...\"]"

# The compiler (lexer, parser, emitter) is loaded on the first load call.
define lr_need_compiler as:
    if lr_st.compiler == null:
        load_file of (lr_st.srcdir + "/lex.eigs")
        load_file of (lr_st.srcdir + "/parse.eigs")
        load_file of (lr_st.srcdir + "/emit.eigs")
        lr_st.compiler is 1

# Compile Lua source text into a function whose globals index env:
# [fn], or [null, message] on a syntax error.
define lr_compile(text, chunkid, env) as:
    lr_need_compiler of null
    local code is null
    try:
        local tk is lua_lex of (text)
        local ast is lua_parse of (tk)
        local r is emit_chunk of [ast, len of lr_st.sites]
        for st in r[1]:
            append of [lr_st.sites, [st[0], st[1], st[2], chunkid]]
        code is r[0]
    catch e:
        if type of e == "list" and len of e == 3 and e[0] == "SYNTAX":
            return [null, chunkid + ":" + (str of e[1]) + ": " + e[2]]
        if type of e == "list" and len of e == 3 and e[0] == "UNSUP":
            lr_stderr of ("EIGENLUA-UNSUPPORTED: " + e[1] + " at " + chunkid + ":" + (str of e[2]) + "\n")
            lr_exit of 3
        throw of (e)
    local L is eval of code
    return [L of (env)]

define lr_b_load(A) as:
    local chunk is lr_arg of [A, 0]
    local name is lr_arg of [A, 1]
    local mode is lr_arg of [A, 2]
    local env is lr_G
    if len of A >= 4:
        env is A[3]
    local text is ""
    if type of chunk == "str":
        text is chunk
        if name == null:
            name is chunk
    elif type of chunk == "fn":
        if name == null:
            name is "=(load)"
        local parts is []
        loop while 1:
            local piece is lr_call1 of [chunk, [], 0]
            if piece == null or piece == "":
                break
            if type of piece != "str":
                return [null, "reader function must return a string"]
            append of [parts, piece]
        text is join of [parts, ""]
    else:
        lr_argerr of [1, "load", "string expected, got " + (lr_typearg of [A, 0])]
    if type of name != "str":
        name is lr_checkstr of [A, 1, "load"]
    if mode != null and index_of of [lr_checkstr of [A, 2, "load"], "t"] < 0:
        return [null, "attempt to load a text chunk (mode is '" + mode + "')"]
    return lr_compile of [text, lr_chunkid of (name), env]

define lr_b_loadfile(A) as:
    local fname is lr_arg of [A, 0]
    if fname == null:
        lr_unsup of ["loadfile from stdin", 0]
    fname is lr_checkstr of [A, 0, "loadfile"]
    local mode is lr_arg of [A, 1]
    local env is lr_G
    if len of A >= 3:
        env is A[2]
    if not (file_exists of fname):
        return [null, "cannot open " + fname]
    if mode != null and index_of of [lr_checkstr of [A, 1, "loadfile"], "t"] < 0:
        return [null, "attempt to load a text chunk (mode is '" + mode + "')"]
    local text is read_text of fname
    if len of text > 0 and text[0] == "#":
        local nl is index_of of [text, "\n"]
        if nl < 0:
            text is ""
        else:
            text is "--" + text[nl:]
    return lr_compile of [text, lr_chunkid of ("@" + fname), env]

define lr_b_dofile(A) as:
    local r is lr_b_loadfile of ([lr_arg of [A, 0]])
    if r[0] == null:
        lr_throw of (r[1])
    return lr_call of [r[0], [], 0]

# require (loadlib.c): package.loaded, then package.preload, then a Lua file
# on package.path. C loaders are out of scope (GAPS.md).
define lr_b_require(A) as:
    local name is lr_checkstr of [A, 0, "require"]
    local loaded is lr_rawget of [lr_pkglib, "loaded"]
    local have is lr_index of [loaded, name, 0]
    if lr_t of (have):
        return [have]
    local msg is []
    local loader is null
    local extra is null
    local pre is lr_index of [lr_pkglib, "preload", 0]
    local pf is null
    if type of pre == "dict":
        pf is lr_index of [pre, name, 0]
    if pf != null:
        loader is pf
        extra is ":preload:"
    else:
        append of [msg, "\n\tno field package.preload['" + name + "']"]
        local path is lr_index of [lr_pkglib, "path", 0]
        if type of path != "str":
            lr_throw of ((lr_where of (1)) + "'package.path' must be a string")
        local sp is lr_searchpath of [name, path, ".", "/"]
        if sp[0] == null:
            append of [msg, sp[1]]
        else:
            local r is lr_b_loadfile of ([sp[0]])
            if r[0] == null:
                lr_throw of ((lr_where of (1)) + "error loading module '" + name + "' from file '" + sp[0] + "':\n\t" + r[1])
            loader is r[0]
            extra is sp[0]
    if loader == null:
        lr_throw of ((lr_where of (1)) + "module '" + name + "' not found:" + (join of [msg, ""]))
    local res is lr_call1 of [loader, [name, extra], 0]
    if res != null:
        lr_setindex of [loaded, name, res, 0]
    elif lr_index of [loaded, name, 0] == null:
        lr_setindex of [loaded, name, true, 0]
    return [lr_index of [loaded, name, 0], extra]

# [filename, null] or [null, "\n\tno file '...'..."]
define lr_searchpath(name, path, sep, rep) as:
    if sep != "":
        name is str_replace of [name, sep, rep]
    local msg is []
    for tmpl in split of [path, ";"]:
        if tmpl != "":
            local fn is str_replace of [tmpl, "?", name]
            if file_exists of fn:
                return [fn, null]
            append of [msg, "\n\tno file '" + fn + "'"]
    return [null, join of [msg, ""]]

define lr_p_searchpath(A) as:
    local name is lr_checkstr of [A, 0, "searchpath"]
    local path is lr_checkstr of [A, 1, "searchpath"]
    local sep is "."
    local rep is "/"
    if lr_arg of [A, 2] != null:
        sep is lr_checkstr of [A, 2, "searchpath"]
    if lr_arg of [A, 3] != null:
        rep is lr_checkstr of [A, 3, "searchpath"]
    return lr_searchpath of [name, path, sep, rep]

# warn (lauxlib.c warnf*): off at start as in lua.c; "@on"/"@off" control
# it; when on, the message goes to stderr.
define lr_b_warn(A) as:
    if len of A == 0:
        lr_argerr of [1, "warn", "string expected, got no value"]
    local parts is []
    local i is 0
    for v in A:
        append of [parts, lr_checkstr of [A, i, "warn"]]
        i is i + 1
    local msg is join of [parts, ""]
    if len of A == 1 and len of msg > 0 and msg[0] == "@":
        if msg == "@on":
            lr_st.warn is true
        elif msg == "@off":
            lr_st.warn is false
        return []
    if lr_st.warn == true:
        lr_stderr of ("Lua warning: " + msg + "\n")
    return []

# ------------------------------------------------------------ to-be-closed

define lr_tbc_check(v, name, site) as:
    if not (lr_t of (v)):
        return null
    if lr_metafield of [v, "__close"] == null:
        lr_rterr of [site, "variable '" + name + "' got a non-closable value"]

define lr_tbc_close(tb, err, site) as:
    if tb[1]:
        return null
    tb[1] is true
    local v is tb[0]
    if not (lr_t of (v)):
        return null
    lr_callmm of [lr_metafield of [v, "__close"], "close", [v, err], site]

# An error unwinds a to-be-closed variable: close it with the error value
# (an error in __close replaces the original), then go on unwinding.
define lr_tbc_unwind(tb, e, site) as:
    if not tb[1]:
        if type of e == "dict" and e.COCLOSE == 1:
            lr_tbc_close of [tb, null, site]
        else:
            lr_tbc_close of [tb, lr_errobj of (e), site]
    throw of (e)

# ------------------------------------------------------------ globals

define lr_lib(fns, stubs, trap) as:
    local t is lr_newtable of null
    for k in keys of fns:
        lr_rawset of [t, k, fns[k], 0]
    for k in keys of stubs:
        lr_rawset of [t, k, lr_stub of (stubs[k]), 0]
    if len of trap > 0:
        t.trap is trap
    return t

define lr_stubs(prefix, names) as:
    local d is {}
    for nm in split of [names, " "]:
        d[nm] is prefix + nm
    return d

define lr_init_lib as:
    null

lr_G is lr_newtable of null
lr_strlib is lr_lib of [{"sub": lr_s_sub, "len": lr_s_len, "upper": lr_s_upper, "lower": lr_s_lower, "rep": lr_s_rep, "reverse": lr_s_reverse, "byte": lr_s_byte, "char": lr_s_char, "format": lr_s_format, "find": lr_s_find, "match": lr_s_match, "gmatch": lr_s_gmatch, "gsub": lr_s_gsub}, lr_stubs of ["string.", "dump pack packsize unpack"], {}]
lr_strmt is lr_newtable of null
lr_rawset of [lr_strmt, "__index", lr_strlib, 0]
lr_tablib is lr_lib of [{"insert": lr_t_insert, "remove": lr_t_remove, "concat": lr_t_concat, "pack": lr_t_pack, "unpack": lr_t_unpack, "sort": lr_t_sort}, lr_stubs of ["table.", "move"], {}]
lr_mathlib is lr_lib of [{"floor": lr_m_floor, "ceil": lr_m_ceil, "abs": lr_m_abs, "sqrt": lr_m_sqrt, "max": lr_m_max, "min": lr_m_min, "type": lr_m_type, "tointeger": lr_m_tointeger, "fmod": lr_m_fmod, "random": lr_m_random, "randomseed": lr_m_randomseed, "sin": lr_m_sin, "cos": lr_m_cos, "tan": lr_m_tan, "asin": lr_m_asin, "acos": lr_m_acos, "atan": lr_m_atan, "exp": lr_m_exp, "log": lr_m_log, "deg": lr_m_deg, "rad": lr_m_rad, "modf": lr_m_modf, "ult": lr_m_ult}, {}, {}]
# math.huge is inf in Lua; the direct translation is EigenScript's own
# overflow, which saturates at 1e308 (gaps/no-nonfinite.eigs)
lr_rawset of [lr_mathlib, "huge", 1e308 * 10, 0]
lr_rawset of [lr_mathlib, "pi", pi of null, 0]
lr_rawset of [lr_mathlib, "maxinteger", 9223372036854775807, 0]
