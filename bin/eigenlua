#!/usr/bin/env bash
# eigenlua <prog.lua>: compile Lua 5.4 to EigenScript (src/compile.eigs), then
# run it on the EigenScript VM. Exit status is the program's; the runtime
# prints EIGENLUA-ASSERTS:<n> on stderr at exit. Unsupported constructs exit 3
# with EIGENLUA-UNSUPPORTED: <construct> at <file>:<line>.
# The VM is $EIGENSCRIPT, else `eigenscript` on PATH, and must have the bool
# type (EigenScript main at 686d3b7d or later; its --version still reads 0.44.0).
set -u
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ES=${EIGENSCRIPT:-$(command -v eigenscript || true)}
[[ $# -eq 1 ]] || { echo "usage: eigenlua <prog.lua>" >&2; exit 2; }
[[ -n $ES && -x $ES ]] || { echo "eigenlua: EigenScript VM not found (set EIGENSCRIPT or put eigenscript on PATH)" >&2; exit 2; }
tmp=$(mktemp -d "${TMPDIR:-/tmp}/eigenlua.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
printf 'print of (type of (1 == 1))\n' >"$tmp/probe.eigs"
[[ $("$ES" "$tmp/probe.eigs" 2>/dev/null) == bool ]] || { echo "eigenlua: $ES has no bool type (need EigenScript 686d3b7d or later)" >&2; exit 2; }
"$ES" "$ROOT/src/compile.eigs" "$1" "$tmp/prog.eigs" "$ROOT/src/runtime.eigs" || exit $?
EIGENLUA_ARGV0=$0 "$ES" "$tmp/prog.eigs"
